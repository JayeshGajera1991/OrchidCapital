<link rel="stylesheet" href="~/css/AnnualReport.css" asp-append-version="true" />
@{
    ViewData["Title"] = Localizer["AnnualReport"];
}
<div class="hero">
    <div class="container">
        <h1>Annual Report 2026</h1>
        <p>Delivering sustainable growth, responsible lending, transparent governance, and long-term value creation.</p>
        <a class="btn" href="#">Download PDF</a>
    </div>
</div>

<section>
    <div class="container">
        <h2 style="margin-bottom:25px;color:#390077">Financial Highlights</h2>
        <div class="grid">
            <div class="card">
                <h3>Loan Portfolio</h3>
                <h2>₹850 Cr</h2>
                <p>Total managed portfolio.</p>
            </div>
            <div class="card">
                <h3>Customers</h3>
                <h2>48,500+</h2>
                <p>Customers served.</p>
            </div>
            <div class="card">
                <h3>Approval Rate</h3>
                <h2>92%</h2>
                <p>Eligible applications approved.</p>
            </div>
            <div class="card">
                <h3>NPA Ratio</h3>
                <h2>1.8%</h2>
                <p>Healthy asset quality.</p>
            </div>
        </div>
    </div>
</section>

<section style="background:#fff">
    <div class="container">
        <h2 style="margin-bottom:20px;color:#390077">Chairman's Message</h2>
        <div class="card">
            <p>Our continued focus on responsible lending, customer trust, and digital transformation has enabled Orchid
                Capital to strengthen its position while maintaining disciplined risk management. We remain committed to
                sustainable growth and delivering value to customers and stakeholders.</p>
            </div>
        </div>
    </section>

    <section>
        <div class="container">
            <h2 style="margin-bottom:20px;color:#390077">Business Performance</h2>
            <table class="table">
                <tr>
                    <th>Segment</th>
                    <th>Performance</th>
                </tr>
                <tr>
                    <td>Business Loans</td>
                    <td>Strong Growth</td>
                </tr>
                <tr>
                    <td>Working Capital</td>
                    <td>Expanded Portfolio</td>
                </tr>
                <tr>
                    <td>Structured Finance</td>
                    <td>Stable Performance</td>
                </tr>
                <tr>
                    <td>Advisory Services</td>
                    <td>Growing Demand</td>
                </tr>
            </table>
        </div>
    </section>

    <section>
        <div class="container">
            <h2 style="margin-bottom:25px;color:#390077">Corporate Governance</h2>
            <div class="grid">
                <div class="card">
                    <h3>Risk Management</h3>
                    <p>Robust credit evaluation and monitoring.</p>
                </div>
                <div class="card">
                    <h3>Compliance</h3>
                    <p>Strong regulatory compliance framework.</p>
                </div>
                <div class="card">
                    <h3>Technology</h3>
                    <p>Secure digital lending infrastructure.</p>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="container">
            <div class="cta">
                <h2>Investor Relations</h2>
                <p>Email: office@orchidcapital.in</p>
                <p>Phone: +91 94038 93113</p>
            </div>
        </div>
    </section>
    <script>
        $(".top-header").addClass('purple-submenu-other');
    </script>