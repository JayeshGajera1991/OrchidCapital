<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<link rel="stylesheet" href="~/css/AboutUs.css" asp-append-version="true" />

@{
   ViewData["Title"] = Localizer["AboutUs"];
   var header = ViewBag.HeaderData as AllModuleListRequest;
}
<section class="hero">

   <div class="container hero-content">

      <div class="hero-left">

         <span class="subtitle">
            ABOUT ORCHID CAPITAL
         </span>

         <h1>
            Your Trusted Financial Partner
         </h1>

         <p>

            Orchid Capital empowers individuals and businesses
            with innovative financial solutions, transparent
            processes and customer-first services.

         </p>

         <div class="hero-buttons">

            <a href="#" class="btn-primary">
               Learn More
            </a>

            <a href="#" class="btn-outline">
               Contact Us
            </a>

         </div>

      </div>

      <div class="hero-right">

         <img src="~/img/about-banner.png" alt="About Orchid Capital">

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- WHO WE ARE -->
<!-- ================================= -->

<section class="about section">

   <div class="container about-grid">

      <div>

         <img src="~/img/about-company.png" class="about-img">

      </div>

      <div>

         <span class="section-tag">
            Who We Are
         </span>

         <h2>

            Helping People Build
            Financial Success

         </h2>

         <p>

            Orchid Capital is committed to providing
            reliable, transparent and customer-focused
            financial solutions.

         </p>

         <p>

            Our experienced professionals help customers
            with Home Finance, Mortgage Finance,
            Business Loans, Supply Chain Finance,
            Export Finance and Bill Discounting.

         </p>

         <ul class="about-list">

            <li>
               <i class="fa-solid fa-check"></i>
               Trusted Financial Experts
            </li>

            <li>
               <i class="fa-solid fa-check"></i>
               Transparent Loan Process
            </li>

            <li>
               <i class="fa-solid fa-check"></i>
               Fast Approval
            </li>

            <li>
               <i class="fa-solid fa-check"></i>
               Customer First Approach
            </li>

         </ul>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- MISSION -->
<!-- ================================= -->

<section class="section">

   <div class="container">

      <div class="section-title">

         <h2>Mission • Vision • Values</h2>

      </div>

      <div class="mission-grid">

         <div class="glass-card">

            <i class="fa-solid fa-bullseye"></i>

            <h3>Mission</h3>

            <p>

               Deliver innovative financial solutions
               through trust and transparency.

            </p>

         </div>

         <div class="glass-card">

            <i class="fa-solid fa-eye"></i>

            <h3>Vision</h3>

            <p>

               Become India's most trusted
               financial partner.

            </p>

         </div>

         <div class="glass-card">

            <i class="fa-solid fa-heart"></i>

            <h3>Values</h3>

            <p>

               Integrity,
               Innovation,
               Commitment,
               Customer Satisfaction.

            </p>

         </div>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- WHY CHOOSE -->
<!-- ================================= -->

<section class="section light">

   <div class="container">

      <div class="section-title">

         <h2>
            Why Choose Orchid Capital
         </h2>

      </div>

      <div class="why-grid">

         <div class="why-box">
            <i class="fa-solid fa-bolt"></i>
            <h4>Fast Approval</h4>
         </div>

         <div class="why-box">
            <i class="fa-solid fa-percent"></i>
            <h4>Competitive Interest</h4>
         </div>

         <div class="why-box">
            <i class="fa-solid fa-user-group"></i>
            <h4>Expert Team</h4>
         </div>

         <div class="why-box">
            <i class="fa-solid fa-shield"></i>
            <h4>100% Transparency</h4>
         </div>

         <div class="why-box">
            <i class="fa-solid fa-headset"></i>
            <h4>24×7 Support</h4>
         </div>

         <div class="why-box">
            <i class="fa-solid fa-wallet"></i>
            <h4>Flexible EMI</h4>
         </div>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- SERVICES -->
<!-- ================================= -->

<section class="section">

   <div class="container">

      <div class="section-title">

         <h2>Our Services</h2>

      </div>

      <div class="services-grid">

         <div class="service-card">

            <i class="fa-solid fa-house"></i>

            <h3>Home Finance</h3>

         </div>

         <div class="service-card">

            <i class="fa-solid fa-building"></i>

            <h3>Mortgage Finance</h3>

         </div>

         <div class="service-card">

            <i class="fa-solid fa-briefcase"></i>

            <h3>Business Finance</h3>

         </div>

         <div class="service-card">

            <i class="fa-solid fa-truck"></i>

            <h3>Supply Chain Finance</h3>

         </div>

         <div class="service-card">

            <i class="fa-solid fa-earth-asia"></i>

            <h3>Export Finance</h3>

         </div>

         <div class="service-card">

            <i class="fa-solid fa-coins"></i>

            <h3>Bill Discounting</h3>

         </div>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- ACHIEVEMENTS -->
<!-- ================================= -->

<section class="stats">

   <div class="container stats-grid">

      <div>

         <h2>5000+</h2>

         <p>Happy Customers</p>

      </div>

      <div>

         <h2>₹500 Cr+</h2>

         <p>Loan Portfolio</p>

      </div>

      <div>

         <h2>25+</h2>

         <p>Partners</p>

      </div>

      <div>

         <h2>98%</h2>

         <p>Approval Rate</p>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- PROCESS -->
<!-- ================================= -->

<section class="section">

   <div class="container">

      <div class="section-title">

         <h2>Our Process</h2>

      </div>

      <div class="timeline">

         <div class="step">

            <span>1</span>

            <h4>Apply</h4>

         </div>

         <div class="step">

            <span>2</span>

            <h4>Verification</h4>

         </div>

         <div class="step">

            <span>3</span>

            <h4>Approval</h4>

         </div>

         <div class="step">

            <span>4</span>

            <h4>Disbursement</h4>

         </div>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- TEAM -->
<!-- ================================= -->

<section class="section light">

   <div class="container">

      <div class="section-title">
         <h2>Leadership Team</h2>
      </div>

      <div class="swiper teamSwiper">

         <div class="swiper-wrapper">

            @if (header != null)
            {
               foreach (TeamModel item in header.TeamsList)
               {
                  <div class="swiper-slide">
                     <div class="team-card">
                        <img src="~/img/usericon.png">
                        <h3>@(string.IsNullOrEmpty(item.FullName) ? "" : item.FullName) </h3>
                        <p>@(string.IsNullOrEmpty(item.Qualification) ? "" : item.Qualification)</p>
                     </div>
                  </div>
               }
            }
         </div>

         <div class="swiper-pagination"></div>

         <div class="swiper-button-next"></div>

         <div class="swiper-button-prev"></div>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- TESTIMONIAL -->
<!-- ================================= -->

<section class="section">

   <div class="container">

      <div class="section-title">

         <h2>Client Testimonials</h2>

      </div>

      <div class="testimonial">

         ★★★★★

         <p>

            Excellent service,
            fast processing
            and professional team.

         </p>

         <h4>

            — Happy Customer

         </h4>

      </div>

   </div>

</section>

<!-- ================================= -->
<!-- CTA -->
<!-- ================================= -->

<section class="cta">

   <div class="container">

      <h2>

         Ready To Achieve Your Financial Goals?

      </h2>

      <p>

         Let's build your future together.

      </p>

      <a href="#" class="btn-primary">

         Apply Now

      </a>

   </div>

</section>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
   $(".top-header").addClass('purple-submenu-other');
   new Swiper(".teamSwiper", {

      loop: true,

      speed: 800,

      spaceBetween: 30,

      autoplay: {
         delay: 2500,
         disableOnInteraction: false
      },

      pagination: {
         el: ".swiper-pagination",
         clickable: true
      },

      navigation: {
         nextEl: ".swiper-button-next",
         prevEl: ".swiper-button-prev"
      },

      breakpoints: {

         0: {
            slidesPerView: 1
         },

         576: {
            slidesPerView: 2
         },

         768: {
            slidesPerView: 3
         },

         1200: {
            slidesPerView: 4
         }

      }

   });
</script>