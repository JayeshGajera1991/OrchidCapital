<link rel="stylesheet" href="~/css/TermsConditions.css" asp-append-version="true" />
@{
    ViewData["Title"] = Localizer["TermsConditions"];
}
<section class="hero">

    <div class="container hero-content">

        <div class="badge">
            Transparent • Secure • RBI Compliant
        </div>

        <h1>Terms & Conditions</h1>

        <p>
            Please read these Terms & Conditions carefully before applying for any loan or using Orchid Capital's
            financial services.
        </p>

        <div class="meta">

            <div class="meta-box">
                <span>Effective Date</span>
                <strong>20 July 2026</strong>
            </div>

            <div class="meta-box">
                <span>Last Updated</span>
                <strong>20 July 2026</strong>
            </div>

        </div>

        <div class="hero-buttons">

            <a href="#" class="btn btn-primary">
                Download PDF
            </a>

            <a href="@Url.Action("ContactUs","Home")" class="btn btn-outline">
                Contact Legal
            </a>

        </div>

    </div>

</section>

<section class="section">

    <div class="container">

        <div class="card">

            <div class="card-header">
                <div class="number">01</div>
                <h2>Acceptance of Terms</h2>
            </div>

            <p>
                By accessing this website or submitting a loan application, you acknowledge that you have read,
                understood and agreed to these Terms & Conditions.
            </p>

        </div>

        <div class="card">

            <div class="card-header">
                <div class="number">02</div>
                <h2>Eligibility</h2>
            </div>

            <ul>

                <li>Applicants must satisfy the applicable eligibility criteria.</li>

                <li>Valid KYC and identity verification are mandatory.</li>

                <li>Income verification may be requested.</li>

                <li>Meeting eligibility criteria does not guarantee loan approval.</li>

            </ul>

        </div>

        <div class="card">

            <div class="card-header">
                <div class="number">03</div>
                <h2>Loan Approval Process</h2>
            </div>

            <p>
                All applications are subject to document verification, credit assessment, regulatory checks, internal
                risk evaluation and approval policies. Orchid Capital reserves the right to approve or reject any
                application without assigning any reason.
            </p>

        </div>

        <div class="card">

            <div class="card-header">
                <div class="number">04</div>
                <h2>Fees & Charges</h2>
            </div>

            <ul>

                <li>Processing Fees</li>

                <li>Documentation Charges</li>

                <li>Applicable Government Taxes</li>

                <li>Late Payment Charges</li>

                <li>Foreclosure / Prepayment Charges (where applicable)</li>

            </ul>

        </div>

        <div class="card">

            <div class="card-header">
                <div class="number">05</div>
                <h2>Privacy & Security</h2>
            </div>

            <p>
                Customer information is protected using industry-standard security measures and processed according to
                our Privacy Policy and applicable legal requirements.
            </p>

        </div>

        <div class="card">

            <div class="card-header">
                <div class="number">06</div>
                <h2>Customer Responsibilities</h2>
            </div>

            <ul>

                <li>Provide complete and accurate information.</li>

                <li>Submit genuine supporting documents.</li>

                <li>Repay loans according to agreed schedules.</li>

                <li>Notify Orchid Capital of changes in contact details.</li>

            </ul>

        </div>

        <div class="card">

            <div class="card-header">
                <div class="number">07</div>
                <h2>Regulatory Compliance</h2>
            </div>

            <p>
                All financial services are governed by applicable laws and regulatory requirements. Customers are
                expected to comply with all applicable legal obligations while using our services.
            </p>

        </div>

        <div class="contact">

            <h2>Need Assistance?</h2>

            <p>📧 office@orchidcapital.in</p>

            <p>📞 +91 94038 93113</p>

            <p>Monday – Saturday | 9:30 AM – 6:30 PM</p>

            <div class="contact-buttons">

                <a href="@Url.Action("ContactUs","Home")" class="btn btn-primary">
                    Contact Us
                </a>

                <a href="@Url.Action("ContactUs","Home")" class="btn btn-outline">
                    Email Support
                </a>

            </div>

        </div>

    </div>

</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>