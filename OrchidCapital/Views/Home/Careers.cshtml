<link rel="stylesheet" href="~/css/Careers.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["Careers"];
}
<section class="loan-careers">
    <!-- Career Hero -->
    <div class="loan-career-hero">
        <div class="container">
            <div class="career-content">
                <span>Careers In Banking</span>
                <h1>
                    Build Your Future In
                    <b>Digital Lending & Finance</b>
                </h1>
                <p>
                    Join our team and help customers achieve their dreams
                    through innovative loan solutions, faster approvals,
                    and trusted financial services.
                </p>
                <a href="#openings" class="btn btn-primary">
                    Explore Jobs
                </a>
            </div>
        </div>
    </div>
    <!-- Banking Career Areas -->
    <section class="career-area">
        <div class="container">
            <div class="title">
                <h2>
                    Career Opportunities
                </h2>
                <p>
                    Grow your career across different areas of lending
                    and financial services.
                </p>
            </div>
            <div class="area-grid">
                <div class="area-card">
                    <i class="fas fa-user-tie"></i>
                    <h3>
                        Relationship Manager
                    </h3>
                    <p>
                        Build customer relationships and provide
                        suitable loan solutions.
                    </p>
                </div>
                <div class="area-card">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <h3>
                        Loan Officer
                    </h3>
                    <p>
                        Manage loan applications, documentation,
                        and customer verification.
                    </p>
                </div>
                <div class="area-card">
                    <i class="fas fa-search-dollar"></i>
                    <h3>
                        Credit Analyst
                    </h3>
                    <p>
                        Analyze borrower profiles and assess
                        credit risk.
                    </p>
                </div>
                <div class="area-card">
                    <i class="fas fa-headset"></i>
                    <h3>
                        Customer Support
                    </h3>
                    <p>
                        Support customers throughout their
                        loan journey.
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Why Join Banking Team -->
    <section class="why-bank-career">
        <div class="container">
            <div class="why-grid">
                <div class="why-image">
                    <img src="~/img/banking-team.png">
                </div>
                <div class="why-content">
                    <h2>
                        Why Build Your Career With Us?
                    </h2>
                    <ul>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            Work with modern digital lending technology
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            Learn banking and financial expertise
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            Career growth and skill development
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            Professional and supportive environment
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!-- Job Openings -->
    <section id="openings" class="job-section">
        <div class="container">
            <div class="title">
                <h2>
                    Current Loan Banking Jobs
                </h2>
            </div>
            <div class="job-list">
                <div class="job-item">
                    <div>
                        <h3>
                            Home Loan Relationship Manager
                        </h3>
                        <p>
                            Ahmedabad | Full Time
                        </p>
                    </div>
                    <button class="btn btn-outline">
                        Apply Now
                    </button>
                </div>
                <div class="job-item">
                    <div>
                        <h3>
                            Credit Processing Executive
                        </h3>
                        <p>
                            Ahmedabad | Full Time
                        </p>
                    </div>
                    <button class="btn btn-outline">
                        Apply Now
                    </button>
                </div>
                <div class="job-item">
                    <div>
                        <h3>
                            Loan Software Developer
                        </h3>
                        <p>
                            Remote | Full Time
                        </p>
                    </div>
                    <button class="btn btn-outline">
                        Apply Now
                    </button>
                </div>
            </div>
        </div>
    </section>
    <!-- Apply Banner -->
    <section class="apply-banner">
        <h2>
            Ready To Grow With Our Banking Team?
        </h2>
        <p>
            Submit your resume and become part of the future of lending.
        </p>
        <a href="#" class="btn btn-primary">
            Submit Resume
        </a>
    </section>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>