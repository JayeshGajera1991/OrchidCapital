<link rel="stylesheet" href="~/css/BusinessLoans.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["BusinessLoans"];
}
<section class="loan-hero">
    <div class="hero-content">
        <h1>
            Business Loans For Your Growth
        </h1>
        <p>
            Expand your business with flexible financing solutions.
            Get quick approval, competitive interest rates and customized
            loan options designed for entrepreneurs.
        </p>
        <a href="#" class="hero-btn">
            Apply Now
        </a>
    </div>
    <div class="hero-image">
        <img src="~/img/business-loan.png" alt="Business Loan">
    </div>
</section>
<!-- Features -->
<section class="section">
    <div class="container">
        <div class="title">
            <h2>Why Choose Business Loan?</h2>
            <p>
                Power your business dreams with smart financial solutions.
            </p>
        </div>
        <div class="loan-features">
            <div class="feature-card">
                <i class="fa-solid fa-bolt"></i>
                <h3>Fast Approval</h3>
                <p>
                    Quick loan processing with minimum documentation.
                </p>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-indian-rupee-sign"></i>
                <h3>Flexible Amount</h3>
                <p>
                    Choose loan amounts according to your business needs.
                </p>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-percent"></i>
                <h3>Competitive Rates</h3>
                <p>
                    Affordable interest rates with transparent charges.
                </p>
            </div>
        </div>
    </div>
</section>
<!-- Benefits -->
<section class="section benefits">
    <div class="container">
        <div class="title">
            <h2>Business Loan Benefits</h2>
        </div>
        <div class="benefit-list">
            <div class="benefit-item">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Working Capital Support</h3>
                    <p>Manage daily business expenses smoothly.</p>
                </div>
            </div>
            <div class="benefit-item">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Business Expansion</h3>
                    <p>Open new branches and grow your business.</p>
                </div>
            </div>
            <div class="benefit-item">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Digital Processing</h3>
                    <p>Apply online anytime from anywhere.</p>
                </div>
            </div>
            <div class="benefit-item">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Flexible Repayment</h3>
                    <p>Select repayment plans suitable for you.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Process -->
<section class="section">
    <div class="container">
        <div class="title">
            <h2>How It Works</h2>
        </div>
        <div class="steps">
            <div class="step">
                <span>1</span>
                <h4>Apply Online</h4>
            </div>
            <div class="step">
                <span>2</span>
                <h4>Document Verification</h4>
            </div>
            <div class="step">
                <span>3</span>
                <h4>Loan Approval</h4>
            </div>
            <div class="step">
                <span>4</span>
                <h4>Get Funds</h4>
            </div>
        </div>
    </div>
</section>
<!-- CTA -->
<section class="cta">
    <h2>
        Ready To Grow Your Business?
    </h2>
    <a href="#">
        Get Business Loan
    </a>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>