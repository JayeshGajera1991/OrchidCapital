<link rel="stylesheet" href="~/css/StructuredFinance.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["StructuredFinance"];
}
<section class="hero">


    <div class="hero-content">

        <h1>
            Structured Finance Solutions
        </h1>


        <p>
            Customized financial solutions designed for large enterprises,
            infrastructure projects and complex business requirements.
            Our structured finance solutions help organizations achieve
            long-term growth with optimized capital structures.
        </p>


        <a href="#" class="hero-btn">
            Explore Solutions
        </a>


    </div>


    <div class="hero-image">

        <img src="~/img/structured-finance.png">

    </div>


</section>




<!-- SERVICES -->


<section class="section">


    <div class="container">


        <div class="section-title">

            <h2>
                Our Structured Finance Services
            </h2>

            <p>
                Comprehensive banking solutions for complex financial needs.
            </p>

        </div>



        <div class="finance-grid">



            <div class="finance-card">

                <i class="fa-solid fa-building-columns"></i>

                <h3>
                    Corporate Lending
                </h3>

                <p>
                    Tailored financing solutions for established businesses and enterprises.
                </p>

            </div>



            <div class="finance-card">

                <i class="fa-solid fa-chart-line"></i>

                <h3>
                    Project Finance
                </h3>

                <p>
                    Funding solutions for infrastructure and development projects.
                </p>

            </div>




            <div class="finance-card">

                <i class="fa-solid fa-handshake"></i>

                <h3>
                    Debt Structuring
                </h3>

                <p>
                    Optimize capital structure with customized debt solutions.
                </p>

            </div>



        </div>


    </div>


</section>





<!-- SOLUTIONS -->


<section class="section solutions">


    <div class="container">


        <div class="section-title">

            <h2>
                Structured Finance Solutions
            </h2>

        </div>



        <div class="solution-box">


            <div class="solution-item">

                <i class="fa-solid fa-landmark"></i>

                <h3>
                    Asset Based Finance
                </h3>

            </div>



            <div class="solution-item">

                <i class="fa-solid fa-money-bill-transfer"></i>

                <h3>
                    Loan Syndication
                </h3>

            </div>



            <div class="solution-item">

                <i class="fa-solid fa-file-invoice-dollar"></i>

                <h3>
                    Working Capital Solutions
                </h3>

            </div>



            <div class="solution-item">

                <i class="fa-solid fa-diagram-project"></i>

                <h3>
                    Special Purpose Financing
                </h3>

            </div>



        </div>


    </div>


</section>





<!-- PROCESS -->


<section class="section">


    <div class="container">


        <div class="section-title">

            <h2>
                Our Process
            </h2>

        </div>



        <div class="process">


            <div class="process-card">

                <div class="process-number">1</div>

                <h4>Requirement Analysis</h4>

            </div>


            <div class="process-card">

                <div class="process-number">2</div>

                <h4>Financial Assessment</h4>

            </div>


            <div class="process-card">

                <div class="process-number">3</div>

                <h4>Solution Design</h4>

            </div>


            <div class="process-card">

                <div class="process-number">4</div>

                <h4>Funding Execution</h4>

            </div>


        </div>


    </div>


</section>





<!-- WHY -->


<section class="section">


    <div class="container why">


        <img src="images/corporate-finance.jpg">


        <div class="why-content">

            <h2>
                Why Choose Orchid Capital?
            </h2>


            <ul class="why-list">

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Experienced financial experts
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Customized financing structures
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Transparent banking process
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Long-term business partnership
                </li>

            </ul>


        </div>


    </div>


</section>





<!-- CTA -->


<section class="cta">

    <h2>
        Build Your Financial Future With Us
    </h2>

    <p>
        Connect with our structured finance specialists today.
    </p>


    <a href="#">
        Contact Us
    </a>


</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>