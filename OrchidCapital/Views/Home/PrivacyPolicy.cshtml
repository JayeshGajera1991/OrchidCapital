@{
    ViewData["Title"] = @Localizer["PrivacyPolicy"];
}
<link rel="stylesheet" href="~/css/PrivacyPolicy.css" asp-append-version="true" />
<section class="hero">
    <div class="hero-content">
        <h1>
            Privacy Policy
        </h1>
        <p>
            Your privacy and data security are our highest priorities.
        </p>
    </div>
    <div class="hero-image">
        <img src="~/img/privacy-banner.png">
    </div>
</section>
<section class="section">
    <div class="container">
        <div class="policy-wrapper">
            <!-- MENU -->
            <div class="policy-menu">
                <h3>
                    Policy Contents
                </h3>
                <a href="#overview">
                    Overview
                </a>
                <a href="#information">
                    Information Collection
                </a>
                <a href="#usage">
                    Data Usage
                </a>
                <a href="#security">
                    Security
                </a>
                <a href="#cookies">
                    Cookies
                </a>
                <a href="#contact">
                    Contact Us
                </a>
            </div>
            <!-- CONTENT -->
            <div class="policy-content">
                <h2 id="overview">
                    1. Overview
                </h2>
                <p>
                    Orchid Capital respects your privacy and is committed to protecting
                    your personal information. This Privacy Policy explains how we
                    collect, use and safeguard your information when you use our
                    banking and financial services.
                </p>
                <h2 id="information">
                    2. Information We Collect
                </h2>
                <p>
                    We may collect the following information while providing banking
                    services:
                </p>
                <ul>
                    <li>
                        Personal details such as name, email, mobile number and address.
                    </li>
                    <li>
                        Identity verification and KYC related information.
                    </li>
                    <li>
                        Loan application and financial information.
                    </li>
                    <li>
                        Transaction and account related information.
                    </li>
                </ul>
                <h2 id="usage">
                    3. How We Use Your Information
                </h2>
                <p>
                    Your information is used for:
                </p>
                <ul>
                    <li>
                        Processing loan applications and financial services.
                    </li>
                    <li>
                        Providing customer support.
                    </li>
                    <li>
                        Improving banking products and services.
                    </li>
                    <li>
                        Maintaining regulatory compliance.
                    </li>
                </ul>
                <h2 id="security">
                    4. Data Security
                </h2>
                <p>
                    We implement appropriate technical and organizational security
                    measures to protect customer information against unauthorized
                    access, modification, disclosure or misuse.
                </p>
                <h2 id="cookies">
                    5. Cookies Policy
                </h2>
                <p>
                    Our website may use cookies to improve user experience,
                    analyze website performance and provide better services.
                    You may manage cookie preferences through your browser settings.
                </p>
                <h2>
                    6. Third Party Services
                </h2>
                <p>
                    We may work with trusted service providers for payment processing,
                    verification and technology services while ensuring appropriate
                    security controls.
                </p>
                <h2>
                    7. Policy Updates
                </h2>
                <p>
                    We may update this Privacy Policy periodically. Any changes will
                    be published on this page with the revised effective date.
                </p>
                <h2 id="contact">
                    8. Contact Us
                </h2>
                <p>
                    If you have any questions regarding this Privacy Policy,
                    please contact Orchid Capital customer support.
                </p>
                <div class="info-section">
                    <div class="info-card">
                        <i class="fa-solid fa-shield-halved"></i>
                        <h4>
                            Secure Banking
                        </h4>
                        <p>
                            Advanced protection for customer data.
                        </p>
                    </div>
                    <div class="info-card">
                        <i class="fa-solid fa-user-lock"></i>
                        <h4>
                            Data Privacy
                        </h4>
                        <p>
                            Your information remains confidential.
                        </p>
                    </div>
                    <div class="info-card">
                        <i class="fa-solid fa-headset"></i>
                        <h4>
                            Support
                        </h4>
                        <p>
                            Dedicated customer assistance.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- CTA -->
<section class="cta">
    <h2>
        Your Trust Is Our Priority
    </h2>
    <p>
        Secure, transparent and responsible banking experience.
    </p>
    <a href="@Url.Action("ContactUs", "Home")" class="btn btn-primary">
        Contact Us
    </a>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>