<link rel="stylesheet" href="~/css/WorkingCapital.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["WorkingCapital"];
}
<section class="hero">
    <div class="hero-content">
        <h1>
            Working Capital Finance
        </h1>
        <p>
            Empower your business operations with flexible working capital
            solutions. Manage daily expenses, inventory, payroll and business
            growth requirements with reliable banking support.
        </p>
        <a href="@Url.Action("UserRequest", "Home")" class="btn btn-primary">
            Apply Now
        </a>
    </div>
    <div class="hero-image">
        <img src="~/img/working-capital.png">
    </div>
</section>
<!-- SERVICES -->
<section class="section">
    <div class="container">
        <div class="title">
            <h2>
                Working Capital Solutions
            </h2>
            <p>
                Financial support designed for your business needs.
            </p>
        </div>
        <div class="products">
            <div class="card">
                <i class="fa-solid fa-wallet"></i>
                <h3>
                    Cash Credit
                </h3>
                <p>
                    Flexible credit facility to manage regular business operations.
                </p>
            </div>
            <div class="card">
                <i class="fa-solid fa-file-invoice-dollar"></i>
                <h3>
                    Overdraft Facility
                </h3>
                <p>
                    Access funds whenever your business requires additional liquidity.
                </p>
            </div>
            <div class="card">
                <i class="fa-solid fa-boxes-stacked"></i>
                <h3>
                    Inventory Finance
                </h3>
                <p>
                    Finance inventory purchase and maintain smooth supply chain.
                </p>
            </div>
        </div>
    </div>
</section>
<!-- BENEFITS -->
<section class="section benefits">
    <div class="container">
        <div class="title">
            <h2>
                Benefits Of Working Capital Loan
            </h2>
        </div>
        <div class="benefit-grid">
            <div class="benefit">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Improve Cash Flow</h3>
                    <p>Maintain smooth daily business operations.</p>
                </div>
            </div>
            <div class="benefit">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Business Expansion</h3>
                    <p>Support growth opportunities and investments.</p>
                </div>
            </div>
            <div class="benefit">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Quick Processing</h3>
                    <p>Simple documentation and faster approvals.</p>
                </div>
            </div>
            <div class="benefit">
                <i class="fa-solid fa-check"></i>
                <div>
                    <h3>Flexible Repayment</h3>
                    <p>Choose repayment options suitable for your business.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- TYPES -->
<section class="section">
    <div class="container">
        <div class="title">
            <h2>
                Business Requirements We Support
            </h2>
        </div>
        <div class="loan-types">
            <div class="loan-box">
                <i class="fa-solid fa-truck"></i>
                <h4>Inventory Purchase</h4>
            </div>
            <div class="loan-box">
                <i class="fa-solid fa-users"></i>
                <h4>Salary Management</h4>
            </div>
            <div class="loan-box">
                <i class="fa-solid fa-store"></i>
                <h4>Business Expansion</h4>
            </div>
            <div class="loan-box">
                <i class="fa-solid fa-chart-line"></i>
                <h4>Growth Funding</h4>
            </div>
        </div>
    </div>
</section>
<!-- PROCESS -->
<section class="section">
    <div class="container">
        <div class="title">
            <h2>
                How It Works
            </h2>
        </div>
        <div class="process">
            <div class="step">
                <div class="step-number">1</div>
                <h4>Submit Application</h4>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <h4>Business Verification</h4>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <h4>Approval</h4>
            </div>
            <div class="step">
                <div class="step-number">4</div>
                <h4>Get Funds</h4>
            </div>
        </div>
    </div>
</section>
<!-- WHY -->
<section class="section">
    <div class="container why">
        <img src="images/business-finance.jpg">
        <div>
            <h2>
                Why Choose Orchid Capital?
            </h2>
            <ul class="check-list">
                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Customized working capital solutions
                </li>
                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Competitive interest rates
                </li>
                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Dedicated relationship managers
                </li>
                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Secure and transparent banking
                </li>
            </ul>
        </div>
    </div>
</section>
<!-- CTA -->
<section class="cta">
    <h2>
        Keep Your Business Running Smoothly
    </h2>
    <a href="@Url.Action("UserRequest", "Home")" class="btn btn-primary">
        Get Working Capital Loan
    </a>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>