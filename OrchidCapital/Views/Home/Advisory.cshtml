<link rel="stylesheet" href="~/css/Advisory.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["Advisory"];
}
<section class="hero">


    <div class="hero-content">


        <h1>
            Bank Advisory Services
        </h1>


        <p>
            Strategic financial advisory solutions to help businesses,
            corporates and institutions make informed decisions,
            optimize capital and achieve sustainable growth.
        </p>


        <a href="#" class="hero-btn">
            Connect With Experts
        </a>


    </div>



    <div class="hero-image">

        <img src="~/img/advisory.png">

    </div>



</section>





<!-- SERVICES -->


<section class="section">


    <div class="container">


        <div class="title">

            <h2>
                Our Advisory Solutions
            </h2>

            <p>
                Professional guidance backed by financial expertise.
            </p>

        </div>



        <div class="services">


            <div class="service-card">

                <i class="fa-solid fa-chart-pie"></i>

                <h3>
                    Financial Advisory
                </h3>

                <p>
                    Strategic financial planning and customized solutions for businesses.
                </p>

            </div>




            <div class="service-card">

                <i class="fa-solid fa-building-columns"></i>

                <h3>
                    Corporate Advisory
                </h3>

                <p>
                    Support for mergers, acquisitions and corporate restructuring.
                </p>

            </div>




            <div class="service-card">

                <i class="fa-solid fa-coins"></i>

                <h3>
                    Investment Advisory
                </h3>

                <p>
                    Expert guidance to manage investments and financial opportunities.
                </p>

            </div>


        </div>


    </div>


</section>






<!-- SOLUTIONS -->


<section class="section solution-section">


    <div class="container">


        <div class="title">

            <h2>
                Advisory Expertise
            </h2>

        </div>



        <div class="solution-grid">


            <div class="solution-box">

                <i class="fa-solid fa-handshake"></i>

                <h3>
                    Mergers & Acquisitions Advisory
                </h3>

            </div>



            <div class="solution-box">

                <i class="fa-solid fa-chart-line"></i>

                <h3>
                    Capital Raising Solutions
                </h3>

            </div>



            <div class="solution-box">

                <i class="fa-solid fa-file-contract"></i>

                <h3>
                    Risk Management Advisory
                </h3>

            </div>



            <div class="solution-box">

                <i class="fa-solid fa-lightbulb"></i>

                <h3>
                    Business Strategy Consulting
                </h3>

            </div>


        </div>


    </div>


</section>







<!-- EXPERTISE -->


<section class="section">


    <div class="container expertise">


        <img src="images/banking-advisory.jpg">



        <div class="expertise-content">


            <h2>
                Why Choose Orchid Capital Advisory?
            </h2>



            <ul class="expertise-list">


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Experienced financial professionals
                </li>


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Industry-focused banking solutions
                </li>


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Data-driven financial decisions
                </li>


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Long-term client partnerships
                </li>


            </ul>


        </div>


    </div>


</section>







<!-- PROCESS -->


<section class="section">


    <div class="container">


        <div class="title">

            <h2>
                Our Advisory Process
            </h2>

        </div>



        <div class="process">


            <div class="process-item">

                <div class="number">1</div>

                <h4>Understand Requirement</h4>

            </div>



            <div class="process-item">

                <div class="number">2</div>

                <h4>Financial Analysis</h4>

            </div>



            <div class="process-item">

                <div class="number">3</div>

                <h4>Strategy Development</h4>

            </div>



            <div class="process-item">

                <div class="number">4</div>

                <h4>Implementation Support</h4>

            </div>



        </div>


    </div>


</section>






<!-- CTA -->


<section class="cta">


    <h2>
        Make Smarter Financial Decisions
    </h2>


    <p>
        Partner with Orchid Capital's advisory specialists.
    </p>


    <a href="#">
        Contact Advisory Team
    </a>


</section>
