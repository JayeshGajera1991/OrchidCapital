<link rel="stylesheet" href="~/css/Compliance.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["Compliance"];
}
<section class="hero">


    <div class="hero-content">


        <h1>
            Bank Compliance
        </h1>


        <p>
            Strong governance, regulatory excellence and responsible banking
            practices to ensure secure and transparent financial services.
        </p>


        <a href="#" class="hero-btn">
            Learn More
        </a>


    </div>


    <img src="~/img/compliance-banner.png">


</section>






<!-- COMPLIANCE SERVICES -->


<section class="section">


    <div class="container">


        <div class="title">

            <h2>
                Our Compliance Framework
            </h2>

            <p>
                Maintaining highest standards of banking governance.
            </p>

        </div>



        <div class="compliance-grid">


            <div class="card">

                <i class="fa-solid fa-scale-balanced"></i>

                <h3>
                    Regulatory Compliance
                </h3>

                <p>
                    Ensuring complete adherence with banking laws,
                    regulations and industry standards.
                </p>

            </div>




            <div class="card">

                <i class="fa-solid fa-shield-halved"></i>

                <h3>
                    Risk Management
                </h3>

                <p>
                    Identifying, monitoring and controlling financial risks.
                </p>

            </div>




            <div class="card">

                <i class="fa-solid fa-user-shield"></i>

                <h3>
                    Customer Protection
                </h3>

                <p>
                    Protecting customer information and financial interests.
                </p>

            </div>



        </div>


    </div>


</section>






<!-- FRAMEWORK -->


<section class="section framework">


    <div class="container">


        <div class="title">

            <h2>
                Compliance Areas
            </h2>

        </div>



        <div class="framework-grid">


            <div class="framework-box">

                <i class="fa-solid fa-file-contract"></i>

                <h3>
                    KYC & Customer Verification
                </h3>

            </div>



            <div class="framework-box">

                <i class="fa-solid fa-money-bill-transfer"></i>

                <h3>
                    AML Monitoring
                </h3>

            </div>



            <div class="framework-box">

                <i class="fa-solid fa-lock"></i>

                <h3>
                    Data Security Compliance
                </h3>

            </div>



            <div class="framework-box">

                <i class="fa-solid fa-building-columns"></i>

                <h3>
                    Banking Regulations
                </h3>

            </div>



        </div>


    </div>


</section>






<!-- GOVERNANCE -->


<section class="section">


    <div class="container governance">


        <img src="images/bank-governance.jpg">



        <div>


            <h2>
                Compliance & Governance
            </h2>


            <ul class="list">


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Transparent banking operations
                </li>


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Strong internal controls
                </li>


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Regular compliance monitoring
                </li>


                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Ethical business practices
                </li>


            </ul>


        </div>


    </div>


</section>







<!-- PROCESS -->


<section class="section">


    <div class="container">


        <div class="title">

            <h2>
                Compliance Process
            </h2>

        </div>



        <div class="process">


            <div class="step">

                <span>1</span>

                <h4>Identify Risk</h4>

            </div>



            <div class="step">

                <span>2</span>

                <h4>Review Controls</h4>

            </div>



            <div class="step">

                <span>3</span>

                <h4>Monitor Activity</h4>

            </div>



            <div class="step">

                <span>4</span>

                <h4>Report & Improve</h4>

            </div>


        </div>


    </div>


</section>







<!-- REPORTING -->


<section class="section">


    <div class="container">


        <div class="reporting">


            <h2>
                Responsible Banking Commitment
            </h2>


            <p>
                We continuously improve our compliance framework to maintain
                trust, transparency and secure financial services for customers.
            </p>


        </div>


    </div>


</section>







<!-- CTA -->


<section class="cta">


    <h2>
        Trust Through Compliance
    </h2>


    <a href="#">
        Contact Compliance Team
    </a>


</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>