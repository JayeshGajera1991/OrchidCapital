<link rel="stylesheet" href="~/css/UserRequest.css" asp-append-version="true" />
@{
    ViewData["Title"] = Localizer["LoanApply"];
    var header = ViewBag.HeaderData as AllModuleListRequest;
}
<section class="hero">
    <div class="container hero-grid">
        <div class="hero-content">
            <span class="badge">
                Fast Approval • Lowest Interest • 100% Secure
            </span>
            <h1>Apply For Your Dream Loan</h1>
            <p>
                Get quick approval with minimal documentation and attractive interest
                rates. Apply online in just a few minutes.
            </p>
            <div class="hero-buttons">
                <a href="#loanForm" class="btn btn-primary">
                    Apply Now
                </a>
                <a href="@Url.Action("ContactUs", "Home")" class="btn btn-outline">
                    Contact Expert
                </a>
            </div>
        </div>
        <div class="hero-image">
            <img src="~/img/request-loan.png" alt="Loan Request">
        </div>
    </div>
</section>
<!-- =========================
 LOAN PRODUCTS
========================== -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Choose Your Loan</h2>
            <p>Select the loan that best matches your financial needs.</p>
        </div>
        <div class="loan-grid">
            @if (header != null)
            {
                foreach (LoanTypeModel item in header.ProductTypesList)
                {
                    <div class="loan-card">
                        @{
                            string icon = item.LoanTypeId switch
                            {
                                1 => "fa-solid fa-house",
                                2 => "fa-solid fa-briefcase",
                                3 => "fa-solid fa-user",
                                4 => "fa-solid fa-coins",
                                5 => "fa-solid fa-car",
                                6 => "fa-solid fa-graduation-cap",
                                7 => "fa-solid fa-tractor",
                                8 => "fa-solid fa-industry",
                                9 => "fa-solid fa-building-columns",
                                10 => "fa-solid fa-hand-holding-dollar",
                                11 => "fa-solid fa-chart-line",
                                12 => "fa-solid fa-sack-dollar",
                                13 => "fa-solid fa-landmark",
                                14 => "fa-solid fa-building",
                                15 => "fa-solid fa-store",
                                16 => "fa-solid fa-shop",
                                17 => "fa-solid fa-wallet",
                                18 => "fa-solid fa-credit-card",
                                19 => "fa-solid fa-money-check-dollar",
                                20 => "fa-solid fa-piggy-bank",
                                21 => "fa-solid fa-file-invoice-dollar",
                                22 => "fa-solid fa-chart-pie",
                                23 => "fa-solid fa-scale-balanced",
                                24 => "fa-solid fa-seedling",
                                25 => "fa-solid fa-handshake",
                                _ => "fa-solid fa-circle-dollar-to-slot"
                            };
                        }

                        <i class="@icon"></i>
                        <h3>@item.Name</h3>
                        <a href="#loanForm" class="btn btn-primary">Apply Now</a>
                    </div>

                }
            }
        </div>
    </div>
</section>
<!-- =========================
 WHY CHOOSE US
========================== -->
<section class="section light">
    <div class="container">
        <div class="section-title">
            <h2>Why Choose Orchid Capital?</h2>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <i class="fa-solid fa-bolt"></i>
                <h4>Instant Approval</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-percent"></i>
                <h4>Lowest Interest</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-file-circle-check"></i>
                <h4>Paperless Process</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-shield-halved"></i>
                <h4>Secure Application</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-headset"></i>
                <h4>24×7 Support</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-handshake"></i>
                <h4>Trusted Service</h4>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 APPLICATION FORM
========================== -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Loan Request Form</h2>
            <p>Fill in your details to apply online.</p>
        </div>
        <form id="loanForm" class="loan-form">
            <div class="form-grid">
                <input type="text" placeholder="Full Name">
                <input type="email" placeholder="Email Address">
                <input type="tel" placeholder="Mobile Number">
                <select>
                    <option>Select Loan Type</option>
                    @if (header != null)
                    {
                        foreach (LoanTypeModel item in header.ProductTypesList)
                        {
                            <option value="@item.LoanTypeId">@item.Name</option>
                        }
                    }
                </select>
                <input type="number" placeholder="Loan Amount">
                <input type="number" placeholder="Monthly Income">
                <input type="text" placeholder="Occupation">
                <input type="text" placeholder="City">
                <textarea rows="5" placeholder="Additional Information"></textarea>
            </div>
            <button class="btn btn-primary">
                Submit Application
            </button>
        </form>
    </div>
</section>
<!-- =========================
 DOCUMENTS
========================== -->
<section class="section light">
    <div class="container">
        <div class="section-title">
            <h2>Required Documents</h2>
        </div>
        <div class="doc-grid">
            <div class="doc-card">
                <i class="fa-solid fa-id-card"></i>
                <h4>Aadhaar Card</h4>
            </div>
            <div class="doc-card">
                <i class="fa-solid fa-address-card"></i>
                <h4>PAN Card</h4>
            </div>
            <div class="doc-card">
                <i class="fa-solid fa-file-invoice"></i>
                <h4>Salary Slip</h4>
            </div>
            <div class="doc-card">
                <i class="fa-solid fa-building-columns"></i>
                <h4>Bank Statement</h4>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 PROCESS
========================== -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Loan Process</h2>
        </div>
        <div class="process-grid">
            <div class="process">
                <span>1</span>
                <h4>Apply Online</h4>
            </div>
            <div class="process">
                <span>2</span>
                <h4>Verification</h4>
            </div>
            <div class="process">
                <span>3</span>
                <h4>Approval</h4>
            </div>
            <div class="process">
                <span>4</span>
                <h4>Disbursement</h4>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 FAQ
========================== -->
<section class="section light">
    <div class="container">
        <div class="section-title">
            <h2>Frequently Asked Questions</h2>
        </div>
        <div class="faq-item">
            <h3>How long does approval take?</h3>
            <p>Usually within 24–48 business hours.</p>
        </div>
        <div class="faq-item">
            <h3>Can I apply online?</h3>
            <p>Yes. You can apply anytime from our website.</p>
        </div>
        <div class="faq-item">
            <h3>Are there any hidden charges?</h3>
            <p>No. Our charges are completely transparent.</p>
        </div>
    </div>
</section>
<!-- =========================
 CTA
========================== -->
<section class="cta">
    <div class="container">
        <h2>Need Financial Assistance?</h2>
        <p>
            Apply today and our loan expert will contact you shortly.
        </p>
        <a href="#loanForm" class="btn btn-primary">
            Apply Now
        </a>
    </div>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>