<link rel="stylesheet" href="~/css/UserRequest.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["LoanApply"];
   var header = ViewBag.HeaderData as AllModuleListRequest;
}
<section class="hero">
    <div class="container hero-grid">
        <div class="hero-content">
            <span class="badge">
                Fast Approval • Lowest Interest • 100% Secure
            </span>
            <h1>Apply For Your Dream Loan</h1>
            <p>
                Get quick approval with minimal documentation and attractive interest
                rates. Apply online in just a few minutes.
            </p>
            <div class="hero-buttons">
                <a href="#loanForm" class="btn-primary">
                    Apply Now
                </a>
                <a href="#" class="btn-outline">
                    Contact Expert
                </a>
            </div>
        </div>
        <div class="hero-image">
            <img src="~/img/request-loan.png" alt="Loan Request">
        </div>
    </div>
</section>
<!-- =========================
 LOAN PRODUCTS
========================== -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Choose Your Loan</h2>
            <p>Select the loan that best matches your financial needs.</p>
        </div>
        <div class="loan-grid">
            <div class="loan-card">
                <i class="fa-solid fa-house"></i>
                <h3>Home Loan</h3>
                <p>Interest starts from 8.50%</p>
                <a href="#">Apply Now</a>
            </div>
            <div class="loan-card">
                <i class="fa-solid fa-wallet"></i>
                <h3>Personal Loan</h3>
                <p>Instant approval with flexible EMI.</p>
                <a href="#">Apply Now</a>
            </div>
            <div class="loan-card">
                <i class="fa-solid fa-briefcase"></i>
                <h3>Business Loan</h3>
                <p>Up to ₹10 Crore financing.</p>
                <a href="#">Apply Now</a>
            </div>
            <div class="loan-card">
                <i class="fa-solid fa-car"></i>
                <h3>Vehicle Loan</h3>
                <p>Affordable EMI for new & used vehicles.</p>
                <a href="#">Apply Now</a>
            </div>
            <div class="loan-card">
                <i class="fa-solid fa-coins"></i>
                <h3>Gold Loan</h3>
                <p>Maximum value against your gold.</p>
                <a href="#">Apply Now</a>
            </div>
            <div class="loan-card">
                <i class="fa-solid fa-graduation-cap"></i>
                <h3>Education Loan</h3>
                <p>Support for higher education.</p>
                <a href="#">Apply Now</a>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 WHY CHOOSE US
========================== -->
<section class="section light">
    <div class="container">
        <div class="section-title">
            <h2>Why Choose Orchid Capital?</h2>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <i class="fa-solid fa-bolt"></i>
                <h4>Instant Approval</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-percent"></i>
                <h4>Lowest Interest</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-file-circle-check"></i>
                <h4>Paperless Process</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-shield-halved"></i>
                <h4>Secure Application</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-headset"></i>
                <h4>24×7 Support</h4>
            </div>
            <div class="feature-card">
                <i class="fa-solid fa-handshake"></i>
                <h4>Trusted Service</h4>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 APPLICATION FORM
========================== -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Loan Request Form</h2>
            <p>Fill in your details to apply online.</p>
        </div>
        <form id="loanForm" class="loan-form">
            <div class="form-grid">
                <input type="text" placeholder="Full Name">
                <input type="email" placeholder="Email Address">
                <input type="tel" placeholder="Mobile Number">
                <select>
                    <option>Select Loan Type</option>
                    <option>Home Loan</option>
                    <option>Business Loan</option>
                    <option>Personal Loan</option>
                    <option>Vehicle Loan</option>
                    <option>Gold Loan</option>
                    <option>Education Loan</option>
                </select>
                <input type="number" placeholder="Loan Amount">
                <input type="number" placeholder="Monthly Income">
                <input type="text" placeholder="Occupation">
                <input type="text" placeholder="City">
                <textarea rows="5" placeholder="Additional Information"></textarea>
            </div>
            <button class="btn-primary">
                Submit Application
            </button>
        </form>
    </div>
</section>
<!-- =========================
 DOCUMENTS
========================== -->
<section class="section light">
    <div class="container">
        <div class="section-title">
            <h2>Required Documents</h2>
        </div>
        <div class="doc-grid">
            <div class="doc-card">
                <i class="fa-solid fa-id-card"></i>
                <h4>Aadhaar Card</h4>
            </div>
            <div class="doc-card">
                <i class="fa-solid fa-address-card"></i>
                <h4>PAN Card</h4>
            </div>
            <div class="doc-card">
                <i class="fa-solid fa-file-invoice"></i>
                <h4>Salary Slip</h4>
            </div>
            <div class="doc-card">
                <i class="fa-solid fa-building-columns"></i>
                <h4>Bank Statement</h4>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 PROCESS
========================== -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Loan Process</h2>
        </div>
        <div class="process-grid">
            <div class="process">
                <span>1</span>
                <h4>Apply Online</h4>
            </div>
            <div class="process">
                <span>2</span>
                <h4>Verification</h4>
            </div>
            <div class="process">
                <span>3</span>
                <h4>Approval</h4>
            </div>
            <div class="process">
                <span>4</span>
                <h4>Disbursement</h4>
            </div>
        </div>
    </div>
</section>
<!-- =========================
 FAQ
========================== -->
<section class="section light">
    <div class="container">
        <div class="section-title">
            <h2>Frequently Asked Questions</h2>
        </div>
        <div class="faq-item">
            <h3>How long does approval take?</h3>
            <p>Usually within 24–48 business hours.</p>
        </div>
        <div class="faq-item">
            <h3>Can I apply online?</h3>
            <p>Yes. You can apply anytime from our website.</p>
        </div>
        <div class="faq-item">
            <h3>Are there any hidden charges?</h3>
            <p>No. Our charges are completely transparent.</p>
        </div>
    </div>
</section>
<!-- =========================
 CTA
========================== -->
<section class="cta">
    <div class="container">
        <h2>Need Financial Assistance?</h2>
        <p>
            Apply today and our loan expert will contact you shortly.
        </p>
        <a href="#loanForm" class="btn-primary">
            Apply Now
        </a>
    </div>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>