<link rel="stylesheet" href="~/css/Newsroom.css" asp-append-version="true" />
@{
   ViewData["Title"] = Localizer["Newsroom"];
}
<section class="bank-newsroom">
    <!-- Hero -->
    <div class="news-hero">
        <div class="container">
            <div class="news-content">
                <span>Banking Updates</span>
                <h1>
                    Latest News &
                    <strong>Financial Insights</strong>
                </h1>
                <p>
                    Stay updated with our latest announcements,
                    loan solutions, banking innovations and company news.
                </p>
            </div>
        </div>
    </div>
    <!-- Featured News -->
    <section class="featured-news">
        <div class="container">
            <div class="section-title">
                <h2>
                    Featured News
                </h2>
                <p>
                    Discover our latest banking initiatives and updates.
                </p>
            </div>
            <div class="news-grid">
                <article class="news-card featured">
                    <img src="~/img/digital-banking.png">
                    <div class="news-body">
                        <span>
                            Digital Banking
                        </span>
                        <h3>
                            Launching Faster Digital Loan Approval Platform
                        </h3>
                        <p>
                            Our new technology platform helps customers
                            get faster and smarter loan services.
                        </p>
                        <a href="#">
                            Read More →
                        </a>
                    </div>
                </article>
                <article class="news-card">
                    <img src="~/img/home-loan.png">
                    <div class="news-body">
                        <small>
                            18 July 2026
                        </small>
                        <h3>
                            Home Loan Interest Rate Updates
                        </h3>
                        <p>
                            Latest information about home loan products.
                        </p>
                        <a href="#">
                            Read More
                        </a>
                    </div>
                </article>
                <article class="news-card">
                    <img src="~/img/business-loan.png">
                    <div class="news-body">
                        <small>
                            10 July 2026
                        </small>
                        <h3>
                            Supporting Small Business Growth
                        </h3>
                        <p>
                            Business loan solutions designed for entrepreneurs.
                        </p>
                        <a href="#">
                            Read More
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </section>
    <!-- Press Release -->
    <section class="press-section">
        <div class="container">
            <div class="section-title">
                <h2>
                    Press Releases
                </h2>
            </div>
            <div class="press-list">
                <div class="press-item">
                    <div class="date-box">
                        <b>
                            20
                        </b>
                        JUL
                    </div>
                    <div>
                        <h3>
                            Orchid Capital Expands Digital Lending Services
                        </h3>
                        <p>
                            New initiatives introduced to improve
                            customer loan experience.
                        </p>
                    </div>
                    <a href="#">
                        View
                    </a>
                </div>
                <div class="press-item">
                    <div class="date-box">
                        <b>
                            12
                        </b>
                        JUL
                    </div>
                    <div>
                        <h3>
                            New Customer Service Centre Opened
                        </h3>
                        <p>
                            Improving support for loan customers.
                        </p>
                    </div>
                    <a href="#">
                        View
                    </a>
                </div>
            </div>
        </div>
    </section>
    <!-- Subscribe -->
    <section class="news-subscribe">
        <h2>
            Subscribe To Banking Updates
        </h2>
        <p>
            Receive latest financial news and loan updates.
        </p>
        <div class="subscribe-box">
            <input type="email"
            placeholder="Enter your email">
            <button>
                Subscribe
            </button>
        </div>
    </section>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>