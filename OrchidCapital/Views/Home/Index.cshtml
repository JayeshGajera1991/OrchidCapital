@{
    ViewData["Title"] = Localizer["WelcomeMessage"];
    var header = ViewBag.HeaderData as AllModuleListRequest;
}
@await Html.PartialAsync("_UserHeroYono5")
<section class="usp-bar">
    <div class="usp-left">
        <img src="~/img/logo.png" alt="Logo">
    </div>
    <div class="usp-center">
        <div class="usp-item">
            <i class="fa-solid fa-chart-pie"></i>
            <span>@Localizer["FinanceUpto500AssetValue"]</span>
        </div>

        <div class="usp-item">
            <i class="fa-solid fa-coins"></i>
            <span>@Localizer["LowNoEMIExpertise"]</span>
        </div>

        <div class="usp-item">
            <i class="fa-solid fa-arrow-trend-up"></i>
            <span>@Localizer["FinanceOnFutureProjection"]</span>
        </div>

        <div class="usp-item">
            <i class="fa-solid fa-award"></i>
            <span>@Localizer["TwentyYearsExperience"]</span>
        </div>
    </div>
</section>
@await Html.PartialAsync("_UserWhatWeDo")
@await Html.PartialAsync("_UserFinancialCalculator")
<partial name="_UserWhyUs" />
<partial name="_UserPartners" />
@await Html.PartialAsync("_UserTeams")
<script>
    $(".top-header").removeClass('purple-submenu-other');
</script>