<script>
    $(".top-header").addClass('purple-submenu-other');
    const accordionItems = document.querySelectorAll(".accordion-item");
    accordionItems.forEach(item => {
        const btn = item.querySelector(".accordion-header");
        btn.onclick = () => {
            const active = item.classList.contains("active");
            accordionItems.forEach(x => {
                x.classList.remove("active");
                x.querySelector("i").classList.remove("fa-minus");
                x.querySelector("i").classList.add("fa-plus");
            });
            if (!active) {
                item.classList.add("active");
                item.querySelector("i").classList.remove("fa-plus");
                item.querySelector("i").classList.add("fa-minus");
            }
        }
    });
</script>