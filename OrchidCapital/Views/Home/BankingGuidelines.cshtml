<link rel="stylesheet" href="~/css/BankingGuidelines.css" asp-append-version="true" />
@{
    ViewData["Title"] = Localizer["BankingGuidelines"];
}
<section class="guidelines-hero">
    <div class="container">
        <span class="hero-badge">Responsible Banking</span>

        <h1>Banking Guidelines</h1>

        <p>
            Our banking guidelines promote responsible lending, regulatory
            compliance, transparency, and secure financial services for every customer.
        </p>
    </div>
</section>

<section class="guidelines-section">

    <div class="container">

        <div class="guideline-card">

            <div class="guideline-icon">01</div>

            <div class="guideline-content">
                <h2>Responsible Borrowing</h2>

                <p>
                    Borrow only the amount required and ensure your repayment
                    obligations are manageable within your financial capacity.
                </p>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">02</div>

            <div class="guideline-content">
                <h2>Eligibility Assessment</h2>

                <ul>
                    <li>Minimum eligibility criteria must be satisfied.</li>
                    <li>Income and repayment capacity are evaluated.</li>
                    <li>Credit history may be considered.</li>
                    <li>Approval is subject to internal assessment.</li>
                </ul>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">03</div>

            <div class="guideline-content">
                <h2>Know Your Customer (KYC)</h2>

                <p>
                    Customers must provide valid identity, address and income
                    documents in accordance with applicable KYC regulations.
                </p>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">04</div>

            <div class="guideline-content">
                <h2>Documentation</h2>

                <ul>
                    <li>Government-issued Identity Proof</li>
                    <li>Address Proof</li>
                    <li>PAN Card</li>
                    <li>Income Proof</li>
                    <li>Bank Statements</li>
                </ul>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">05</div>

            <div class="guideline-content">
                <h2>Transparent Charges</h2>

                <p>
                    Processing fees, applicable taxes, interest rates and other
                    charges are disclosed before loan disbursement.
                </p>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">06</div>

            <div class="guideline-content">
                <h2>Repayment Guidelines</h2>

                <ul>
                    <li>Pay EMIs on or before the due date.</li>
                    <li>Maintain sufficient account balance.</li>
                    <li>Avoid missed or delayed payments.</li>
                    <li>Contact us if repayment difficulties arise.</li>
                </ul>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">07</div>

            <div class="guideline-content">
                <h2>Fraud Prevention</h2>

                <ul>
                    <li>Never share OTPs or passwords.</li>
                    <li>Verify official communication channels.</li>
                    <li>Report suspicious activities immediately.</li>
                    <li>Protect confidential financial information.</li>
                </ul>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">08</div>

            <div class="guideline-content">
                <h2>Regulatory Compliance</h2>

                <p>
                    All lending activities are conducted in accordance with
                    applicable laws, regulatory requirements and internal
                    compliance policies.
                </p>
            </div>

        </div>

        <div class="guideline-card">

            <div class="guideline-icon">09</div>

            <div class="guideline-content">
                <h2>Customer Support</h2>

                <p>
                    Our support team is available to assist with loan enquiries,
                    documentation, repayment information and grievance resolution.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="guidelines-contact">

    <div class="container">

        <h2>Need Assistance?</h2>

        <p>
            If you have questions regarding our Banking Guidelines,
            please contact our customer support team.
        </p>

        <div class="contact-info">

            <div class="contact-box">
                <h4>Email</h4>
                <p>office@orchidcapital.in</p>
            </div>

            <div class="contact-box">
                <h4>Phone</h4>
                <p>+91 94038 93113</p>
            </div>

            <div class="contact-box">
                <h4>Working Hours</h4>
                <p>Mon – Sat | 9:30 AM – 6:30 PM</p>
            </div>

        </div>

    </div>
</section>
<script>
    $(".top-header").addClass('purple-submenu-other');
</script>