@{
    ViewData["Title"] = "Admin Pages";
}
@{
    var today = DateTime.Now;

    var currentQuarterStartMonth = ((today.Month - 1) / 3) * 3 + 1;
    var currentQuarterStart = new DateTime(today.Year, currentQuarterStartMonth, 1);

    var startDate = currentQuarterStart.AddMonths(-3).ToString("MMM yyyy");
    var endDate = currentQuarterStart.AddMonths(-1).ToString("MMM yyyy");
}
<link rel="stylesheet" href="~/Admin/css/financereport.css" asp-append-version="true" />
<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>Financial Report</h2>
                <p>Manage financial report information and settings</p>
            </div>
        </div>
        <div class="customer-toolbar">
            <div class="period-filter">
                <i class="fa-regular fa-calendar"></i>
               @startDate - @endDate
            </div>
            <div class="page-actions tooltip">
                <button class="btn btn-secondary"
                        onclick="AFinanceApplicationList._AFinanceApplicationList.ExportToExcel('APortal_LoanApplication', 'Loan Application List');">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="tooltip-text">Export to Excel</span>
                </button>
            </div>
        </div>
    </div>
    <section class="summary-grid">

        <div class="summary-card">
            <div class="summary-top">
                <p>Total Loan Portfolio</p>
                <div class="summary-icon purple">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                </div>
            </div>
            <h2>₹ 8.45 Cr</h2>
            <small class="success-text">
                <i class="fa-solid fa-arrow-up"></i> 12.5% from previous quarter
            </small>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <p>Interest Income</p>
                <div class="summary-icon green">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
            </div>
            <h2>₹ 46.80 L</h2>
            <small class="success-text">
                <i class="fa-solid fa-arrow-up"></i> 9.2% from previous quarter
            </small>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <p>Operating Expenses</p>
                <div class="summary-icon orange">
                    <i class="fa-solid fa-wallet"></i>
                </div>
            </div>
            <h2>₹ 12.40 L</h2>
            <small>
                26.5% of total income
            </small>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <p>Net Profit</p>
                <div class="summary-icon red">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
            </div>
            <h2>₹ 28.75 L</h2>
            <small class="success-text">
                <i class="fa-solid fa-arrow-up"></i> 15.8% from previous quarter
            </small>
        </div>

    </section>
    <div class="guarantor-card-main">
        <section class="report-grid">

            <div class="report-card">
                <div class="card-header">
                    <div>
                        <h3>Income and Expense Summary</h3>
                        <p>Quarterly financial overview</p>
                    </div>
                    <a href="#">View Details</a>
                </div>

                <div class="finance-list">

                    <div class="finance-item">
                        <div class="finance-left">
                            <div class="finance-icon green">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>
                            <div>
                                <h4>Interest Income</h4>
                                <p>Interest received from active loan accounts</p>
                            </div>
                        </div>
                        <div class="finance-right">
                            <h4>₹ 46.80 L</h4>
                            <p>+9.2%</p>
                        </div>
                    </div>

                    <div class="finance-item">
                        <div class="finance-left">
                            <div class="finance-icon purple">
                                <i class="fa-solid fa-file-invoice-dollar"></i>
                            </div>
                            <div>
                                <h4>Processing Fee Income</h4>
                                <p>Loan processing and documentation charges</p>
                            </div>
                        </div>
                        <div class="finance-right">
                            <h4>₹ 6.25 L</h4>
                            <p>+6.5%</p>
                        </div>
                    </div>

                    <div class="finance-item">
                        <div class="finance-left">
                            <div class="finance-icon orange">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div>
                                <h4>Operational Expenses</h4>
                                <p>Staff salary, branch operations and administration</p>
                            </div>
                        </div>
                        <div class="finance-right">
                            <h4>₹ 12.40 L</h4>
                            <p class="expense">-4.2%</p>
                        </div>
                    </div>

                    <div class="finance-item">
                        <div class="finance-left">
                            <div class="finance-icon red">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div>
                                <h4>Provision for Bad Loans</h4>
                                <p>Reserve amount for possible loan defaults</p>
                            </div>
                        </div>
                        <div class="finance-right">
                            <h4>₹ 3.90 L</h4>
                            <p class="expense">-2.8%</p>
                        </div>
                    </div>

                </div>

                <div class="finance-total">
                    <h4>Net Financial Result</h4>
                    <strong>₹ 36.75 L</strong>
                </div>
            </div>

            <div class="report-card">
                <div class="card-header">
                    <div>
                        <h3>Key Financial Ratios</h3>
                        <p>Portfolio health indicators</p>
                    </div>
                </div>

                <div class="ratio-list">

                    <div class="ratio-item">
                        <div class="ratio-top">
                            <h4>Collection Efficiency</h4>
                            <span class="good">96.8%</span>
                        </div>
                        <p>Percentage of EMI collected against total due amount</p>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:96.8%; background:#1aaf6c;"></div>
                        </div>
                    </div>

                    <div class="ratio-item">
                        <div class="ratio-top">
                            <h4>Non-Performing Loans</h4>
                            <span class="warning-text">2.4%</span>
                        </div>
                        <p>Loans overdue for more than 90 days</p>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:24%; background:#f39a31;"></div>
                        </div>
                    </div>

                    <div class="ratio-item">
                        <div class="ratio-top">
                            <h4>Portfolio at Risk</h4>
                            <span class="danger-text">4.8%</span>
                        </div>
                        <p>Outstanding balance from overdue loan accounts</p>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:48%; background:#e65252;"></div>
                        </div>
                    </div>

                    <div class="ratio-item">
                        <div class="ratio-top">
                            <h4>Return on Loan Portfolio</h4>
                            <span class="good">8.7%</span>
                        </div>
                        <p>Net return generated from the active loan portfolio</p>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:87%; background:#6657d9;"></div>
                        </div>
                    </div>

                </div>
            </div>

        </section>

        <section class="report-grid">

            <div class="report-card">
                <div class="card-header">
                    <div>
                        <h3>Monthly Financial Performance</h3>
                        <p>Net income generated in the last six months</p>
                    </div>
                    <span>Amount in Lakh</span>
                </div>

                <div class="monthly-performance">
                    <div class="month-column">
                        <span class="bar-value">₹ 18L</span>
                        <div class="bar" style="height:45%;"></div>
                        <span>Jan</span>
                    </div>

                    <div class="month-column">
                        <span class="bar-value">₹ 21L</span>
                        <div class="bar" style="height:55%;"></div>
                        <span>Feb</span>
                    </div>

                    <div class="month-column">
                        <span class="bar-value">₹ 19L</span>
                        <div class="bar" style="height:48%;"></div>
                        <span>Mar</span>
                    </div>

                    <div class="month-column">
                        <span class="bar-value">₹ 25L</span>
                        <div class="bar" style="height:68%;"></div>
                        <span>Apr</span>
                    </div>

                    <div class="month-column">
                        <span class="bar-value">₹ 28L</span>
                        <div class="bar" style="height:78%;"></div>
                        <span>May</span>
                    </div>

                    <div class="month-column">
                        <span class="bar-value">₹ 32L</span>
                        <div class="bar" style="height:90%;"></div>
                        <span>Jun</span>
                    </div>
                </div>
            </div>

            <div class="report-card">
                <div class="card-header">
                    <div>
                        <h3>Branch Performance</h3>
                        <p>Loan portfolio and recovery rate</p>
                    </div>
                    <a href="#">View All</a>
                </div>

                <div class="branch-list">

                    <div class="branch-item">
                        <div class="branch-left">
                            <div class="branch-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div>
                                <h4>Ahmedabad Branch</h4>
                                <p>Portfolio: ₹ 2.45 Cr</p>
                            </div>
                        </div>
                        <div class="branch-right">
                            <h4>98.2%</h4>
                            <p>Recovery Rate</p>
                        </div>
                    </div>

                    <div class="branch-item">
                        <div class="branch-left">
                            <div class="branch-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div>
                                <h4>Surat Branch</h4>
                                <p>Portfolio: ₹ 1.80 Cr</p>
                            </div>
                        </div>
                        <div class="branch-right">
                            <h4>96.5%</h4>
                            <p>Recovery Rate</p>
                        </div>
                    </div>

                    <div class="branch-item">
                        <div class="branch-left">
                            <div class="branch-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div>
                                <h4>Vadodara Branch</h4>
                                <p>Portfolio: ₹ 1.42 Cr</p>
                            </div>
                        </div>
                        <div class="branch-right">
                            <h4>95.7%</h4>
                            <p>Recovery Rate</p>
                        </div>
                    </div>

                    <div class="branch-item">
                        <div class="branch-left">
                            <div class="branch-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div>
                                <h4>Rajkot Branch</h4>
                                <p>Portfolio: ₹ 1.20 Cr</p>
                            </div>
                        </div>
                        <div class="branch-right">
                            <h4>94.3%</h4>
                            <p>Recovery Rate</p>
                        </div>
                    </div>

                </div>
            </div>

        </section>

        <section class="table-card">
            <div class="card-header">
                <div>
                    <h3>Loan Recovery and EMI Collection Details</h3>
                    <p>Recent high-value loan recovery transactions</p>
                </div>
                <a href="#">View Full Report</a>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Loan Type</th>
                            <th>Outstanding Amount</th>
                            <th>EMI Due</th>
                            <th>EMI Received</th>
                            <th>Recovery Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <div class="customer">
                                    <div class="customer-avatar">RK</div>
                                    Rahul Kumar
                                </div>
                            </td>
                            <td>Home Loan</td>
                            <td>₹ 18,50,000</td>
                            <td>₹ 24,500</td>
                            <td>₹ 24,500</td>
                            <td><span class="status paid">Paid</span></td>
                        </tr>

                        <tr>
                            <td>
                                <div class="customer">
                                    <div class="customer-avatar">PS</div>
                                    Priya Shah
                                </div>
                            </td>
                            <td>Business Loan</td>
                            <td>₹ 9,80,000</td>
                            <td>₹ 32,000</td>
                            <td>₹ 20,000</td>
                            <td><span class="status partial">Partial</span></td>
                        </tr>

                        <tr>
                            <td>
                                <div class="customer">
                                    <div class="customer-avatar">AM</div>
                                    Amit Mehta
                                </div>
                            </td>
                            <td>Vehicle Loan</td>
                            <td>₹ 5,25,000</td>
                            <td>₹ 18,500</td>
                            <td>₹ 18,500</td>
                            <td><span class="status paid">Paid</span></td>
                        </tr>

                        <tr>
                            <td>
                                <div class="customer">
                                    <div class="customer-avatar">SN</div>
                                    Sunita Nagar
                                </div>
                            </td>
                            <td>Personal Loan</td>
                            <td>₹ 2,10,000</td>
                            <td>₹ 12,000</td>
                            <td>₹ 0</td>
                            <td><span class="status overdue">Overdue</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
<script>
    var _loadUrls = function () {
        return {
            create: '@Url.Action("Create", "Finance")',
            list: '@Url.Action("List", "Finance")',
            get: '@Url.Action("Edit", "Finance")',
            status: '@Url.Action("Status", "Finance")',
            delete: '@Url.Action("Delete", "Finance")',
            export: '@Url.Action("ExportToExcelFile", "Finance")'
        };
    }
    window.AFinanceReport = {
        configs: {
            urlBase: '@Utility.GetAppSettings("BasePath")',
            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
