            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
@section Scripts {
    @* <script src="~/Admin/js/FinanceLoanApplicationList.js" asp-append-version="true"></script> *@
    <script>
        /* ==========================================================
           LOAN APPROVAL WIZARD (9 STEPS)
        ========================================================== */
        const wizardSteps = document.querySelectorAll(".wizard-step");
        const topSteps = document.querySelectorAll(".loan-step");
        const processBoxes = document.querySelectorAll(".process-box");
        const stepIcons = [
            "fa-solid fa-file-signature",
            "fa-solid fa-folder-tree",
            "fa-solid fa-user-group",
            "fa-solid fa-house-circle-check",
            "fa-solid fa-chart-line",
            "fa-solid fa-stamp",
            "fa-solid fa-calculator",
            "fa-solid fa-money-bill-transfer",
            "fa-solid fa-circle-check"
        ];
        function openStep(index) {
            wizardSteps.forEach((step, i) => {
                step.style.display = (i === index) ? "block" : "none";
            });
            /* ==========================
               TOP HEADER
            ========================== */
            topSteps.forEach((step, i) => {
                step.classList.remove("active", "completed");
                const icon = step.querySelector("i");
                if (i < index) {
                    step.classList.add("completed");
                    icon.className = "fa-solid fa-circle-check";
                } else if (i === index) {
                    step.classList.add("active");
                    icon.className = stepIcons[i];
                } else {
                    icon.className = stepIcons[i];
                }
            });
            /* ==========================
               RIGHT PANEL
            ========================== */
            processBoxes.forEach((box, i) => {
                box.classList.remove("active", "completed");
                if (i < index) {
                    box.classList.add("completed");
                } else if (i === index) {
                    box.classList.add("active");
                }
            });
        }
        /* Initial Step */
        openStep(0);
        /* ==========================================================
           STEP NAVIGATION
        ========================================================== */
        document.getElementById("next1").onclick = () => openStep(1);
        document.getElementById("back1").onclick = () => openStep(0);
        document.getElementById("next2").onclick = () => openStep(2);
        document.getElementById("back2").onclick = () => openStep(1);
        document.getElementById("next3").onclick = () => openStep(3);
        document.getElementById("back3").onclick = () => openStep(2);
        document.getElementById("next4").onclick = () => openStep(4);
        document.getElementById("back4").onclick = () => openStep(3);
        document.getElementById("next5").onclick = () => openStep(5);
        document.getElementById("back5").onclick = () => openStep(4);
        document.getElementById("next6").onclick = () => openStep(6);
        document.getElementById("back6").onclick = () => openStep(5);
        document.getElementById("next7").onclick = () => openStep(7);
        document.getElementById("back7").onclick = () => openStep(6);
        document.getElementById("next8").onclick = () => openStep(8);
        /* ==========================================================
           OPTIONAL FINISH BUTTON
        ========================================================== */
        const finishBtn = document.getElementById("finishLoan");
        if (finishBtn) {
            finishBtn.onclick = function () {
                alert("Loan approval process completed successfully.");
            };
        }
    </script>
    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        document.getElementById('toggleBtn').onclick = () => {
            sidebar.classList.add('show');
            overlay.classList.add('show');
        };
        document.getElementById('closeSidebar').onclick =
            overlay.onclick = () => {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
            };
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>
    <!-- ROLES AND PERMISSION SCRIPT -->
    <script>
        const toggleBtn = document.getElementById("toggleRoleForm");
        const panel = document.getElementById("rolePanel");
        toggleBtn.onclick = () => {
            panel.classList.toggle("show");
        };
        const nextBtn = document.querySelector(".next-btn");
        const backBtn = document.getElementById("backBtn");
        const step1 = document.getElementById("step1");
        const step2 = document.getElementById("step2");
        const steps = document.querySelectorAll(".step");
        const process = document.querySelectorAll(".process-box");
        nextBtn.onclick = () => {
            step1.classList.remove("active");
            step2.classList.add("active");
            steps[0].classList.remove("active");
            steps[1].classList.add("active");
            process[0].classList.remove("active");
            process[1].classList.add("active");
        };
        backBtn.onclick = () => {
            step2.classList.remove("active");
            step1.classList.add("active");
            steps[1].classList.remove("active");
            steps[0].classList.add("active");
            process[1].classList.remove("active");
            process[0].classList.add("active");
        };
        // data tables for roles
    </script>
    <script>
        const profileToggle = document.getElementById("profileToggle");
        const profileMenu = document.getElementById("profileMenu");
        profileToggle.onclick = (e) => {
            e.stopPropagation();
            profileMenu.style.display =
                profileMenu.style.display === "block" ? "none" : "block";
        };
        // close when clicking outside
        document.addEventListener("click", (e) => {
            if (!profileToggle.contains(e.target) && !profileMenu.contains(e.target)) {
                profileMenu.style.display = "none";
            }
        });
        profileToggle.onclick = (e) => {
            e.stopPropagation();
            profileMenu.style.display =
                profileMenu.style.display === "block" ? "none" : "block";
            profileToggle.classList.toggle("open");
        };
    </script>
}