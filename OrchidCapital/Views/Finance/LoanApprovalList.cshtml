@{
    ViewData["Title"] = "Admin Pages";
    Layout = "_LayoutAdmin";
}
<link rel="stylesheet" href="~/Admin/css/admin_roles.css" asp-append-version="true" />
<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>Loan Approval Liat</h2>
                <p>Manage loan approval list information and settings</p>
            </div>
        </div>
        <div class="customer-toolbar">
            <div class="search-box custom-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       onkeyup="APortalModule._APortalMaster.InputBoxSearch(event,this,AFinanceLoanApprovalList._AFinanceLoanApprovalList)"
                       id="ApprovalSearch" placeholder="Search application..." />
                <button type="button" class="search_close_btn btn hidden"
                        onclick="APortalModule._APortalMaster.SearchBoxReset('ApprovalSearch',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">X</button>
            </div>
            @* @Html.DropDownList(
                "statusFilter",
                ViewBag.ApplicationStatusList as SelectList,
                "All",
                new
                {
                    @class =
                    "sort-dropdown",
                    onchange =
 "APortalModule._APortalMaster.StatusChangeEvent(this,AFinanceLoanApprovalList._AFinanceLoanApprovalList)"
                }) *@
            <div class="page-actions tooltip">
                <button class="btn btn-secondary"
                        onclick="AFinanceLoanApprovalList._AFinanceLoanApprovalList.ExportToExcel('APortal_LoanApprovalList', 'Loan Approval List');">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="tooltip-text">Export to Excel</span>
                </button>
            </div>
        </div>
    </div>
    <!-- TABLE -->
    <div class="table-wrapper scroll-body" id="LoanApprovalTableWrapper"
         onscroll="APortalModule._APortalMaster.ScrollMore(event,this,AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
        <table id="tblLoanapprovallist" class="table">
            <thead>
                <tr>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','ApplicationNo',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Application Number
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up ApplicationNo_ASC"></i>
                                <i class="fa-solid fa-sort-down ApplicationNo_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','CustomerName',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Customer Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up CustomerName_ASC active"></i>
                                <i class="fa-solid fa-sort-down CustomerName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','ServiceName',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Service Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up ServiceName_ASC"></i>
                                <i class="fa-solid fa-sort-down ServiceName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','BranchName',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Branch Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up BranchName_ASC"></i>
                                <i class="fa-solid fa-sort-down BranchName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','RequestedAmount',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Requested Amount
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up RequestedAmount_ASC"></i>
                                <i class="fa-solid fa-sort-down RequestedAmount_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','RequestedTenure',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Requested Tenure
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up RequestedTenure_ASC"></i>
                                <i class="fa-solid fa-sort-down RequestedTenure_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','RequestedInterestRate',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Requested Interest Rate
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up RequestedInterestRate_ASC"></i>
                                <i class="fa-solid fa-sort-down RequestedInterestRate_DESC"></i>
                            </span>
                        </a>
                    </th>
                    @* <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','LoanPurpose',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Loan Purpose
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up LoanPurpose_ASC"></i>
                                <i class="fa-solid fa-sort-down LoanPurpose_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','Remarks',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Remarks
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Remarks_ASC"></i>
                                <i class="fa-solid fa-sort-down Remarks_DESC"></i>
                            </span>
                        </a>
                    </th> *@
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','Status',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Application Status
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Status_ASC"></i>
                                <i class="fa-solid fa-sort-down Status_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblLoanapprovallist','CreatedDate',AFinanceLoanApprovalList._AFinanceLoanApprovalList)">
                            Application Date
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up CreatedDate_ASC"></i>
                                <i class="fa-solid fa-sort-down CreatedDate_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody id="approvallist-tbody-render">
                <!-- dynamic -->
            </tbody>
        </table>
    </div>
    <div id="pagination" style="padding: 15px 30px;"></div>
</div>
<script>
    var _loadUrls = function () {
        return {
            create: '@Url.Action("Create", "Finance")',
            list: '@Url.Action("List", "Finance")',
            get: '@Url.Action("Edit", "Finance")',
            status: '@Url.Action("Status", "Finance")',
            delete: '@Url.Action("Delete", "Finance")',
            export: '@Url.Action("ExportToExcelFile", "Finance")'
        };
    }
    window.AFinanceLoanApprovalList = {
        configs: {
            urlBase: '@Utility.GetAppSettings("BasePath")',
            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
@section Scripts {
    <script src="~/Admin/Js/FinanceLoanApprovalList.js" asp-append-version="true"></script>
}