@using DocumentFormat.OpenXml.Office.CustomUI
@{
    var header = ViewBag.HeaderData as AllModuleListRequest;
}
<link rel="stylesheet" href="~/css/whatwedo.css" asp-append-version="true" />
<section class="funding-showcase">
    <div class="mesh-bg"></div>
    <h1 class="showcase-title">@Localizer["WhatWeDo"]</h1>
    <div class="partners-line"></div>
    <p class="showcase-subtitle">@Localizer["WeRaiseFundsFor"]</p>
    <div class="showcase-options">
        @if (header != null)
        {
            string _activeC = "active";
            foreach (LoanTypeModel item in header.ProductTypesList.OrderBy(m => m.LoanTypeId))
            {
                <span class="option @_activeC" data-target="@item.LoanTypeId">@item.Name</span>
                <span class="divider"></span>
                _activeC = "";
            }
        }
    </div>
    <div class="showcase-line"></div>
    <div class="showcase-cards-wrapper">
        <div class="showcase-cards" id="showcaseCards">
            @if (header != null)
            {
                string _activeC = "active";
                foreach (BankServiceListModel item in header.ProductsList)
                {
                    <div class="showcase-card tone-blue @_activeC" data-loan="@item.LoanTypeId">
                        <div class="card-top">
                            <div class="card-icon">
                                <i class="fa-solid fa-industry"></i>
                            </div>
                            <img src="~/LoanProductImage/@item.ImageUrl" alt="@item.ProductName">
                        </div>
                        <div class="card-body">
                            <h3>@item.ProductName</h3>
                            <p>@item.LoanType</p>
                        </div>
                        <button class="card-apply">
                            @Localizer["ApplyNow"]
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                    _activeC = "";
                }
            }
        </div>
    </div>
    <div class="showcase-arrows">
        <button id="prevCard"><i class="fa-solid fa-chevron-left"></i></button>
        <button id="nextCard"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
</section>
<script>
    $(function () {
        let currentIndex = 0;
        const visibleCards = 4;
        const cardWidth = $(".showcase-card").outerWidth(true);
        function slideCards() {
            const $cards = $(".showcase-card:visible");
            if ($cards.length === 0) return;
            const cardWidth = $cards.first().outerWidth(true);
            $("#showcaseCards").css({
                transform: `translateX(-${currentIndex * cardWidth}px)`,
                transition: "transform .4s ease"
            });
        }

        // Next
        $("#nextCard").click(function () {
            const totalCards = $(".showcase-card:visible").length;
            if (currentIndex >= totalCards - visibleCards) {
                currentIndex = 0;
            } else {
                currentIndex++;
            }
            slideCards();
        });

        // Previous
        $("#prevCard").click(function () {
            const totalCards = $(".showcase-card:visible").length;
            currentIndex--;
            // Go to last card
            if (currentIndex < 0) {
                currentIndex = totalCards - 1;
            }
            slideCards();
        });

        $(".option").click(function () {
            currentIndex = 0;
            $(".option").removeClass("active");
            $(this).addClass("active");
            var loanId = $(this).data("target");
            $(".showcase-card").hide();
            $(".showcase-card").removeClass("active");
            $('.showcase-card[data-loan="' + loanId + '"]').addClass("active");
            $('.showcase-card[data-loan="' + loanId + '"]').fadeIn(300);
            slideCards();
        });
        // Default load
        $(".option.active").trigger("click");
    });
</script>