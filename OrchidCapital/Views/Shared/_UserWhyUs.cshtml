<link rel="stylesheet" href="~/css/whyus.css" asp-append-version="true" />
<section class="whyus-section">
    <div class="whyus-left">
        <span class="whyus-tag">@Localizer["WhyChooseUs"]</span>
        <h2>@Localizer["WhyOrchidCapitalStandsApart"]</h2>
        <p>
            @Localizer["WhyUsDescription"]
        </p>
        <button class="whyus-btn">
            @Localizer["KnowMore"]
            <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>
    <div class="whyus-right">
        <div class="comparison-header">
            <div class="comparison-brand">
                <a href="@Url.Action("Index",controller: "Home")"><img src="img/logo.png" class="whyus-logo" alt="@Localizer["CompanyLogo"]"></a>
            </div>
            <span class="others">@Localizer["ComparedToTraditionalLenders"]</span>
        </div>
        <div class="comparison-grid">
            <div class="compare-item">
                <i class="fa-solid fa-bolt"></i>
                <div>
                    <h4>@Localizer["FastApprovals"]</h4>
                    <p>@Localizer["DecisionsWithinHours"]</p>
                </div>
            </div>
            <div class="compare-item">
                <i class="fa-solid fa-layer-group"></i>
                <div>
                    <h4>@Localizer["FlexibleStructuring"]</h4>
                    <p>@Localizer["TailoredFinancialModels"]</p>
                </div>
            </div>
            <div class="compare-item">
                <i class="fa-solid fa-chart-line"></i>
                <div>
                    <h4>@Localizer["FutureProjectionFunding"]</h4>
                    <p>@Localizer["NotJustPastPerformance"]</p>
                </div>
            </div>
            <div class="compare-item">
                <i class="fa-solid fa-file-shield"></i>
                <div>
                    <h4>@Localizer["MinimalDocumentation"]</h4>
                    <p>@Localizer["SimplifiedOnboarding"]</p>
                </div>
            </div>
            <div class="compare-item">
                <i class="fa-solid fa-handshake"></i>
                <div>
                    <h4>@Localizer["RelationshipDriven"]</h4>
                    <p>@Localizer["HumanFirstAdvisory"]</p>
                </div>
            </div>
            <div class="compare-item">
                <i class="fa-solid fa-award"></i>
                <div>
                    <h4>@Localizer["TwentyYearsExpertise"]</h4>
                    <p>@Localizer["ProvenIndustryLeadership"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    window.addEventListener("load", () => {
        document.body.classList.add("loaded");
    });
</script>