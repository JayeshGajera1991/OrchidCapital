@{
    string imagePath = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? string.Empty;
}
<header class="header">
    <!-- LEFT -->
    <div class="header-left">
        <div class="live-clock">
            <i class="fa-regular fa-clock"></i>
            <span id="liveClock"></span>
        </div>
    </div>
    <!-- RIGHT -->
    <div class="header-right">
        <div class="header-actions">

            <div class="header-icon dropdown-trigger" id="notificationBtn">
                <i class="fa-regular fa-bell"></i>
                <span class="badge">3</span>

                <div class="header-dropdown notification-dropdown" id="notificationPanel">
                    <div class="dropdown-header">
                        <div>
                            <h4>Notifications</h4>
                            <span>You have 3 new notifications</span>
                        </div>
                        <button class="mark-read-btn">Mark all read</button>
                    </div>

                    <div class="notification-list">
                        <a href="#" class="notification-item unread">
                            <div class="notify-icon purple-icon">
                                <i class="fa-solid fa-file-circle-check"></i>
                            </div>
                            <div class="notify-content">
                                <h5>New loan application</h5>
                                <p>Rahul Patel submitted a home loan application.</p>
                                <span>5 minutes ago</span>
                            </div>
                            <span class="unread-dot"></span>
                        </a>

                        <a href="#" class="notification-item unread">
                            <div class="notify-icon red-icon">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                            <div class="notify-content">
                                <h5>EMI payment overdue</h5>
                                <p>3 customer EMI payments are overdue today.</p>
                                <span>25 minutes ago</span>
                            </div>
                            <span class="unread-dot"></span>
                        </a>

                        <a href="#" class="notification-item unread">
                            <div class="notify-icon green-icon">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>
                            <div class="notify-content">
                                <h5>Payment received</h5>
                                <p>₹24,500 EMI received from Amit Mehta.</p>
                                <span>1 hour ago</span>
                            </div>
                            <span class="unread-dot"></span>
                        </a>

                        <a href="#" class="notification-item">
                            <div class="notify-icon orange-icon">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <div class="notify-content">
                                <h5>Monthly report ready</h5>
                                <p>June 2026 financial report is now available.</p>
                                <span>Yesterday</span>
                            </div>
                        </a>
                    </div>

                    <a href="#" class="view-all-link">
                        View all notifications
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="header-icon dropdown-trigger" id="messageBtn">
                <i class="fa-regular fa-envelope"></i>
                <span class="badge message-badge">2</span>

                <div class="header-dropdown message-dropdown" id="messagePanel">
                    <div class="dropdown-header">
                        <div>
                            <h4>Messages</h4>
                            <span>2 unread messages</span>
                        </div>
                        <button class="mark-read-btn">View inbox</button>
                    </div>

                    <div class="notification-list">
                        <a href="#" class="notification-item unread">
                            <div class="message-avatar">RP</div>
                            <div class="notify-content">
                                <h5>Rahul Patel</h5>
                                <p>Please check my home loan application status.</p>
                                <span>10 minutes ago</span>
                            </div>
                            <span class="unread-dot"></span>
                        </a>

                        <a href="#" class="notification-item unread">
                            <div class="message-avatar avatar-green">AM</div>
                            <div class="notify-content">
                                <h5>Amit Mehta</h5>
                                <p>I have completed this month's EMI payment.</p>
                                <span>45 minutes ago</span>
                            </div>
                            <span class="unread-dot"></span>
                        </a>

                        <a href="#" class="notification-item">
                            <div class="message-avatar avatar-orange">PS</div>
                            <div class="notify-content">
                                <h5>Priya Shah</h5>
                                <p>Please share the business loan repayment schedule.</p>
                                <span>Yesterday</span>
                            </div>
                        </a>
                    </div>

                    <a href="#" class="view-all-link">
                        Open message center
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

        </div>
