<header class="header">
    <!-- LEFT -->
    <div class="header-left">
        <i class="fa-solid fa-bars hamburger" id="toggleBtn"></i>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Search customers, loans, transactions..." />
        </div>
    </div>
    <!-- RIGHT -->
    <div class="header-right">
        <div class="header-icon">
            <i class="fa-regular fa-bell"></i>
            <span class="badge">3</span>
        </div>
        <div class="header-icon">
            <i class="fa-regular fa-envelope"></i>
        </div>
        <div class="profile-wrapper">
            <div class="profile" id="profileToggle">
                <div class="avatar"></div>
                <div class="profile-info">
                    <span class="name">@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</span>
                    <span class="role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
                <i class="fa-solid fa-chevron-down"></i>
            </div>
            <!-- DROPDOWN -->
            <div class="profile-menu" id="profileMenu">
                <a href="@Url.Action("Profile", "Admin")">
                    <i class="fa-solid fa-user"></i> My Profile
                </a>
                <div class="divider"></div>
                <a href="@Url.Action("Logout", "Login")">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </a>
            </div>
        </div>
    </div>
</header>