<script>
    window.addEventListener("load", () => {

        const slides = document.querySelectorAll(".slide");
        const features = document.querySelectorAll(".feature-content");

        let index = 0;
        let autoSlideInterval;

        function updateSlider(newIndex) {
            slides[index].classList.remove("active");
            features[index].classList.remove("active");

            index = newIndex;

            slides[index].classList.add("active");
            features[index].classList.add("active");
        }

        function startAutoSlide() {
            autoSlideInterval = setInterval(() => {
                let newIndex = (index + 1) % slides.length;
                updateSlider(newIndex);
            }, 3500);
        }

        function resetAutoSlide() {
            clearInterval(autoSlideInterval);
            startAutoSlide();
        }

        document.getElementById("next").onclick = () => {
            resetAutoSlide();
            updateSlider((index + 1) % slides.length);
        };

        document.getElementById("prev").onclick = () => {
            resetAutoSlide();
            updateSlider((index - 1 + slides.length) % slides.length);
        };

        const hero = document.querySelector(".hero-section");

        hero.addEventListener("mouseenter", () => {
            clearInterval(autoSlideInterval);
        });

        hero.addEventListener("mouseleave", () => {
            startAutoSlide();
        });

        startAutoSlide();
    });
</script>


<script>
    const phrases = [
        "What are you looking for?",
        "Search loans, cards, investments...",
        "Find banking solutions...",
        "Explore Orchid Capital services..."
    ];

    const input = document.querySelector(".hero-search input");

    let phraseIndex = 0;
    let letterIndex = 0;
    let isDeleting = false;

    function typeEffect() {
        const currentPhrase = phrases[phraseIndex];

        if (!isDeleting) {
            letterIndex++;
        } else {
            letterIndex--;
        }

        input.setAttribute(
            "placeholder",
            currentPhrase.substring(0, letterIndex)
        );

        let typingSpeed = isDeleting ? 35 : 55;

        if (!isDeleting && letterIndex === currentPhrase.length) {
            typingSpeed = 1400;   // pause at full text
            isDeleting = true;
        }
        else if (isDeleting && letterIndex === 0) {
            isDeleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            typingSpeed = 350;    // pause before next phrase
        }

        setTimeout(typeEffect, typingSpeed);
    }

    /* Smooth fade when changing phrase */
    function startAnimation() {
        input.classList.add("placeholder-fade-in");
        typeEffect();
    }

    startAnimation();
</script>
