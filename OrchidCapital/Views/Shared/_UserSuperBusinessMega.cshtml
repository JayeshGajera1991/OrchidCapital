<link rel="stylesheet" href="~/css/superBusinessMega.css" asp-append-version="true" />
@{
    var header = ViewBag.HeaderData as AllModuleListRequest;
}
<div class="business-panel" id="businessPanel">
    <div class="panel-header">
        <div class="biz-head-left">
            <h2>
                <i class="fa-solid fa-briefcase"></i>
                @Localizer["Business"]
            </h2>
        </div>

        <div class="biz-head-center">
            <img src="~/img/msme.png" alt="@Localizer["MSMELogo"]">
            <span>@Localizer["EmpowerMSME"]</span>
        </div>
        <div class="panel-header-right">
            <a href="@Url.Action("Index",controller: "Home")"><img src="~/Images/logo3.png" alt="Company Logo"></a>
        </div>
    </div>
    <div class="panel-divider"></div> <!-- BODY -->
    <div class="panel-body three-zone"> <!-- LEFT : PRODUCTS -->
        <div class="panel-columns advanced-finance zone-left"> <!-- SECURED -->
            <div class="panel-column finance-group">
                <h4>@Localizer["Secured"]</h4>
                @if (header != null)
                {
                    foreach (BankServiceListModel item in header.ProductsList.Where(m => m.IsSecure == true).ToList())
                    {
                        <a href="@Url.Action("UserRequest","Home")" data-desc="@Html.Raw(@item.Descriptions)">@item.ProductName</a>
                    }
                }
            </div>
            <div class="panel-column finance-group">
                <h4>@Localizer["Unsecured"]</h4>
                @if (header != null)
                {
                    foreach (BankServiceListModel item in header.ProductsList.Where(m => m.IsSecure == false).ToList())
                    {
                        <a href="@Url.Action("UserRequest","Home")" data-desc="@Html.Raw(@item.Descriptions)">@item.ProductName</a>
                    }
                }
            </div>
        </div>
        <div class="zone-middle">
            <div class="finance-detail dynamic-desc">
                <div class="finance-header">
                    <span id="financeTitle"></span>
                </div>
                <div id="financePoints"></div>
                <button class="apply-btn" onclick="window.location.href='@Url.Action("UserRequest", "Home")'">
                    <i class="fa-solid fa-arrow-right"></i>
                    @Localizer["ApplyNow"]
                </button>
            </div>
        </div>
        <div class="zone-right">
            <div class="help-box">
                <h4>@Localizer["NeedHelp"]</h4>
                <p>@Localizer["NeedHelpDescription"]</p>
                <button onclick="window.location.href='@Url.Action("ContactUs", "Home")'">
                    <i class="fa-solid fa-headset"></i>
                    @Localizer["ContactRelationshipManager"]
                </button>
            </div>
        </div>
    </div>
    <div class="panel-emi-tags">
        <span class="emi-tag low">@Localizer["LowEMI"]</span>
        <span class="emi-tag no">@Localizer["NoEMI"]</span>
        <span class="emi-tag flexi">@Localizer["FlexiEMI"]</span>
    </div>

    <div class="panel-footer bank-footer">
        <div class="footer-tagline">
            @Localizer["RaiseEasyBusinessCapital"]
            <span>@Localizer["Unlimited"]</span>
        </div>

        <button id="businessCloseBottom">
            <i class="fa-solid fa-xmark"></i>
            @Localizer["Close"]
        </button>
    </div>
</div>

<script>
   $(document).ready(function () {
    $('.finance-group a').on('mouseenter', function () {
        var product = $.trim($(this).text());
        var desc = $(this).data('desc');
        $('#financeTitle, #financePoints').css('opacity', 0);
        setTimeout(function () {
            $('#financeTitle').text(product);
            $('#financePoints').html(desc);
            $('#financeTitle, #financePoints').css('opacity', 1);
        }, 120);
    });
    $('.finance-group a:first').trigger("mouseenter");
});
</script>

<script>
    (function () {
        const closeBtn = document.getElementById('businessCloseBottom');
        const panel = document.getElementById('businessPanel');

        if (!closeBtn || !panel) return;

        closeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();   // ⭐ prevents menu hover/click conflicts
            panel.classList.remove('active');
        });
    })();
</script>