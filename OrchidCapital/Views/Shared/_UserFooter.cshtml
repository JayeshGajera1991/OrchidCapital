<link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
<footer class="bank-footer">
    <div class="bank-footer-wrapper">

        <div class="bank-footer-grid">

            <!-- BRAND -->
            <div class="bank-footer-brand">
                <a href="@Url.Action("Index",controller: "Home")"><img src="~/Images/logo3.png" alt="@Localizer["CompanyLogo"]"></a>

                <div class="bank-footer-tagline">
                    @Localizer["FooterTagline"]
                </div>

                <div class="bank-footer-certifications">
                    <div class="bank-badge">@Localizer["RBICompliant"]</div>
                    <div class="bank-badge">@Localizer["SecurePlatform"]</div>
                    <div class="bank-badge">@Localizer["ISOStandards"]</div>
                </div>
            </div>

            <!-- COMPANY -->
            <div class="bank-footer-column">
                <h4>@Localizer["Company"]</h4>
                <ul>
                    <li><a href="@Url.Action("AboutUs",controller: "Home")">@Localizer["AboutUs"]</a></li>
                    <li><a href="@Url.Action("Leadership","Home")">@Localizer["Leadership"]</a></li>
                    <li><a href="@Url.Action("Careers","Home")">@Localizer["Careers"]</a></li>
                    <li><a href="@Url.Action("Newsroom","Home")">@Localizer["Newsroom"]</a></li>
                </ul>
            </div>

            <!-- SERVICES -->
            <div class="bank-footer-column">
                <h4>@Localizer["Services"]</h4>
                <ul>
                    <li><a href="@Url.Action("BusinessLoans","Home")">@Localizer["BusinessLoans"]</a></li>
                    <li><a href="@Url.Action("StructuredFinance","Home")">@Localizer["StructuredFinance"]</a></li>
                    <li><a href="@Url.Action("WorkingCapital","Home")">@Localizer["WorkingCapital"]</a></li>
                    <li><a href="@Url.Action("Advisory","Home")">@Localizer["Advisory"]</a></li>
                </ul>
            </div>

            <!-- CONTACT -->
            <div class="bank-footer-column bank-footer-contact">
                <h4>@Localizer["Contact"]</h4>
                <p>@Localizer["Email"] : office@orchidcapital.in</p>
                <p>@Localizer["Phone"] : +91 94038 93113 </p>
                <p>@Localizer["Locations"]</p>
            </div>

        </div>
        <div class="bank-footer-bottom">
            <p>@Localizer["Copyright"] Developed by <a href=" https://www.dywinds.com/"> Dywinds Technologies</a></p>
            <div class="bank-footer-links">
                <a href="@Url.Action("PrivacyPolicy","Home")">@Localizer["PrivacyPolicy"]</a>
                <a href="@Url.Action("Leadership","Home")">@Localizer["Terms"]</a>
                <a href="@Url.Action("Compliance","Home")">@Localizer["Compliance"]</a>
                <a href="@Url.Action("Disclosures","Home")">@Localizer["Disclosures"]</a>
            </div>
        </div>

    </div>
</footer>