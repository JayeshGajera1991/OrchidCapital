<link rel="stylesheet" href="~/css/financialcalculator.css" asp-append-version="true" />
@{
    var header = ViewBag.HeaderData as AllModuleListRequest;
}
<section class="emi-section">
    <div class="emi-header">
        <h2>@Localizer["SimplifyFinancialPlanning"]</h2>
        @* <div class="partners-line"></div> *@
        <p>@Localizer["FlexibleEMIs"]</p>
    </div>
    <div class="emi-tabs-wrapper">
        <button type="button" class="nav-btn prev-btn">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div class="emi-tabs" id="emiTabs">
            @if (header != null)
            {
                foreach (BankServiceListModel item in header.ProductsList)
                {
                    <div class="emi-tab" data-loan="@item.LoanProductId" data-mina="@item.MinAmount" data-maxa="@item.MaxAmount"
                         data-mint="@item.MinTenure" data-maxt="@item.MaxTenure" data-ratedir="@item.DefaultInterestRate"
                         data-ratepfp="@item.ProcessingFeePercent" data-ratepi="@item.PenaltyInterest">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                        <span>@item.ProductName</span>
                    </div>
                }
            }
        </div>
        <button type="button" class="nav-btn next-btn">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
    <div class="emi-container">
        <div class="emi-left">
            <div class="slider-group">
                <label>@Localizer["LoanAmount"]</label>
                <div class="slider-value">₹ <span id="amountVal"></span></div>
                <input type="range" id="loanAmount" step="50000">
            </div>

            <div class="slider-group">
                <label>@Localizer["LoanTenureYears"]</label>
                <div class="slider-value">
                    <span id="tenureVal"></span> @Localizer["Years"]
                </div>
                <input type="range" id="loanTenure" step="1">
            </div>

            <div class="slider-group">
                <label>@Localizer["InterestRate"] (%)</label>
                <div class="slider-value">
                    <span id="rateVal"></span>%
                </div>
                <input type="range" id="interestRate" step="0.1">
            </div>
        </div>

        <div class="emi-right-new">
            <div class="emi-result-new">
                <p>@Localizer["YourMonthlyEMI"]</p>
                <h2>₹ <span id="emiVal">0</span></h2>
            </div>

            <div class="emi-breakdown-new">
                <div>
                    <span>@Localizer["AmountPayable"]</span>
                    <strong>₹ <span id="totalVal">0</span></strong>
                </div>

                <div>
                    <span>@Localizer["TotalInterest"]</span>
                    <strong>₹ <span id="interestVal">0</span></strong>
                </div>

                <div>
                    <span>@Localizer["PrincipalAmount"]</span>
                    <strong>₹ <span id="principalVal">0</span></strong>
                </div>
            </div>

            <div class="emi-actions-new">
                <button class="apply-btn-new" onclick="location.href='@Url.Action("UserRequest","Home")'">@Localizer["ApplyNow"]</button>
                <button class="know-btn-new">@Localizer["KnowMore"]</button>
            </div>

            <div class="emi-triangles-new">
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>
</section>
<script>
    $(document).ready(function () {
        $(".emi-tab").click(function () {
            $(".emi-tab").removeClass("active");
            $(this).addClass("active");

            $("#amountVal").empty();
            $("#amountVal").html($(this).attr('data-mina'));
            $("#loanAmount").attr("min", $(this).attr('data-mina'));
            $("#loanAmount").attr("max", $(this).attr('data-maxa'));
            $("#loanAmount").val($(this).attr('data-mina'));

            $("#tenureVal").empty();
            $("#tenureVal").html($(this).attr('data-mint'));
            $("#loanTenure").attr("min", $(this).attr('data-mint'));
            $("#loanTenure").attr("max", $(this).attr('data-maxt'));
            $("#loanTenure").val($(this).attr('data-mint'));

            $("#rateVal").empty();
            $("#rateVal").html($(this).attr('data-ratedir'));
            $("#interestRate").val($(this).attr('data-ratedir'));


            calculateEMI();
        });
        // Load first product automatically
        $(".emi-tab:first").trigger("click");
    });

    function calculateEMI() {
        const amount = document.getElementById("loanAmount");
        const tenure = document.getElementById("loanTenure");
        const rate = document.getElementById("interestRate");

        const amountVal = document.getElementById("amountVal");
        const tenureVal = document.getElementById("tenureVal");
        const rateVal = document.getElementById("rateVal");

        const emiVal = document.getElementById("emiVal");
        const totalVal = document.getElementById("totalVal");
        const interestVal = document.getElementById("interestVal");
        const principalVal = document.getElementById("principalVal");

        const P = parseFloat(amount.value);
        const annualRate = parseFloat(rate.value);
        const r = (annualRate / 12 / 100);
        const n = (parseFloat(tenure.value) * 12);

        const emi = (P * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
        const total = emi * n;
        const interest = total - P;

        emiVal.textContent = isNaN(emi) ? 0 : emi.toFixed(0);
        totalVal.textContent = isNaN(total) ? 0 : total.toFixed(0);
        interestVal.textContent = isNaN(interest) ? 0 : interest.toFixed(0);
        principalVal.textContent = isNaN(P) ? 0 : P.toFixed(0);

        amountVal.textContent = isNaN(P) ? 0 : P.toFixed(0);
        tenureVal.textContent = tenure.value;
        rateVal.textContent = isNaN(annualRate) ? 0 : annualRate.toFixed(1);

        amount.oninput = calculateEMI;
        tenure.oninput = calculateEMI;
        rate.oninput = calculateEMI;
    }

    $(function () {

        const container = $("#emiTabs");

        $(".next-btn").click(function () {
            container[0].scrollBy({
                left: 250,
                behavior: "smooth"
            });
        });

        $(".prev-btn").click(function () {
            container[0].scrollBy({
                left: -250,
                behavior: "smooth"
            });
        });

    });
</script>