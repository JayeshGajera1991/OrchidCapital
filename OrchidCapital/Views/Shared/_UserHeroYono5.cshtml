}
<link rel="stylesheet" href="~/css/heroYono5.css" asp-append-version="true" />
<section class="hero-section">
    <div class="hero-container">
        <div class="hero-left">
            <h1>@Localizer["HeroTitle"]</h1>

            <div class="hero-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="@Localizer["SearchPlaceholder"].Value" />
                <div class="voice-search">
                    <i class="fa-solid fa-microphone"></i>
                </div>
            </div>

            <div class="banking-grid">
                <div class="banking-card">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    @Localizer["SecureLoans"]
                </div>

                <div class="banking-card">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    @Localizer["UnsecureLoans"]
                </div>

                <div class="banking-card">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    @Localizer["MSMELoans"]
                </div>

                <div class="banking-card">
                    <i class="fa-solid fa-chart-line"></i>
                    @Localizer["PrivateInvestors"]
                </div>

                <div class="banking-card">
                    <i class="fa-solid fa-shield-halved"></i>
                    @Localizer["AgentLogin"]
                </div>
            </div>

            <div class="hero-support">
                <i class="fa-solid fa-phone"></i>

                <div class="hero-support-text">
                    <span>@Localizer["GetSupport"]</span>
                    <strong>1800 123 4567</strong>
                </div>
            </div>
            <div class="hero-left-extension">
                @if (header != null)
                {
                    string _activeC = "active";
                    foreach (ImageConfigurationModel item in header.ImagesList.Where(m => m.Role == "HeroImage").ToList())
                    {
                        <div class="feature-content @_activeC">
                            <div class="feature-text">
                                <h2>@item.Headline</h2>
                                <p>@item.Description</p>
                                <button class="feature-btn">@item.Type</button>
                            </div>
