            </div>
            <div class="hero-decorations">
                <span class="decor-square sq1"></span>
                <span class="decor-square sq2"></span>
                <span class="decor-square sq3"></span>
                <span class="decor-square sq4"></span>
                <span class="decor-square sq5"></span>
                <span class="decor-square sq6"></span>
                <span class="decor-square sq7"></span>
                <span class="decor-square sq8"></span>
                <span class="decor-square sq9"></span>
                <span class="decor-square sq10"></span>
                <span class="decor-square sq11"></span>
                <span class="decor-square sq12"></span>
                <span class="decor-square sq13"></span>
                <span class="decor-square sq14"></span>
                <span class="decor-square sq15"></span>
                <span class="decor-square sq16"></span>
                <span class="decor-square sq17"></span>
                <span class="decor-square sq18"></span>
            </div>
        </div>
        <div class="hero-right">
            <div class="slider">
                <div class="slides">
                    @if (header != null)
                    {
                        string _activeC = "active";
                        foreach (ImageConfigurationModel item in header.ImagesList.Where(m => m.Role ==
         "HeroImage").ToList())
                        {
                            <img src="~/ImageUploads/@item.ImagePath" class="slide @_activeC">
                            _activeC = "";
                        }
                    }
                </div>
                <div class="slider-controls">
                    <button id="prev"><i class="fa-solid fa-chevron-left"></i></button>
                    <button id="next"><i class="fa-solid fa-chevron-right"></i></button>
