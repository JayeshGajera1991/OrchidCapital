</section>
<section class="next-section"></section>
<script>
    const slides = document.querySelectorAll(".slide");
    const features = document.querySelectorAll(".feature-content");

    let index = 0;
    let autoSlideInterval;

    /* Update function */
    function updateSlider(newIndex) {
        slides[index].classList.remove("active");
        features[index].classList.remove("active");

        index = newIndex;

        slides[index].classList.add("active");
        features[index].classList.add("active");
    }

    /* Next / Prev controls */
    document.getElementById("next").onclick = () => {
        resetAutoSlide();
        let newIndex = (index + 1) % slides.length;
        updateSlider(newIndex);
    };

    document.getElementById("prev").onclick = () => {
        resetAutoSlide();
        let newIndex = (index - 1 + slides.length) % slides.length;
        updateSlider(newIndex);
    };

    /* ✅ Auto slide */
    function startAutoSlide() {
        autoSlideInterval = setInterval(() => {
            let newIndex = (index + 1) % slides.length;
            updateSlider(newIndex);
        }, 3500); // ⏱ Premium timing (3.5s)
    }

    /* Reset when user clicks */
    function resetAutoSlide() {
        clearInterval(autoSlideInterval);
        startAutoSlide();
    }

    /* ✅ Pause on hover (very bank-grade feel) */
    const hero = document.querySelector(".hero-section");

    hero.addEventListener("mouseenter", () => {
        clearInterval(autoSlideInterval);
    });

    hero.addEventListener("mouseleave", () => {
        startAutoSlide();
    });

    /* Start */
    startAutoSlide();
</script>


<script>
    const phrases = [
        "@Html.Raw(Localizer["WhatAreYouLookingFor"])",
        "@Html.Raw(Localizer["SearchLoansCardsInvestments"])",
        "@Html.Raw(Localizer["FindBankingSolutions"])",
        "@Html.Raw(Localizer["ExploreOrchidCapitalServices"])"
    ];

    const input = document.querySelector(".hero-search input");

    let phraseIndex = 0;
    let letterIndex = 0;
    let isDeleting = false;

    function typeEffect() {
        const currentPhrase = phrases[phraseIndex];

        if (!isDeleting) {
            letterIndex++;
        } else {
            letterIndex--;
        }

        input.setAttribute(
            "placeholder",
            currentPhrase.substring(0, letterIndex)
        );

        let typingSpeed = isDeleting ? 35 : 55;

        if (!isDeleting && letterIndex === currentPhrase.length) {
            typingSpeed = 1400;   // pause at full text
            isDeleting = true;
        }
        else if (isDeleting && letterIndex === 0) {
            isDeleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            typingSpeed = 350;    // pause before next phrase
        }

        setTimeout(typeEffect, typingSpeed);
    }

    /* Smooth fade when changing phrase */
    function startAnimation() {
        input.classList.add("placeholder-fade-in");
        typeEffect();
    }

    startAnimation();
</script>