<link rel="stylesheet" href="~/css/partners.css" asp-append-version="true" />
<section class="partners-section">
    <div class="partners-wrapper">

        <div class="partners-header">
            <h2>Trusted Financial Network</h2>
            <div class="partners-line"></div>
            <p>Powering growth through strategic financial partnerships</p>
        </div>

        <!-- SCROLL AREA -->
        <div class="partners-scroll" id="partnersScroll">

            <div class="partner-card banks">
                <i class="fa-solid fa-building-columns"></i>
                <h4>Banks</h4>
                <p>Structured funding & regulated lending partnerships.</p>
                <span>Read More</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card nbfc">
                <i class="fa-solid fa-chart-line"></i>
                <h4>NBFC</h4>
                <p>Flexible credit models & specialized financing.</p>
                <span>Read More</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card sidbi">
                <i class="fa-solid fa-landmark"></i>
                <h4>SIDBI</h4>
                <p>Empowering MSME growth through development finance.</p>
                <span>Read More</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card coop">
                <i class="fa-solid fa-handshake"></i>
                <h4>Co-Operatives</h4>
                <p>Localized capital channels for inclusive finance.</p>
                <span>Read More</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card investors">
                <i class="fa-solid fa-user-tie"></i>
                <h4>Investors</h4>
                <p>Private capital & growth acceleration partners.</p>
                <span>Read More</span>
            </div>

        </div>

        <!-- CONTROLS -->
        <div class="scroll-controls">
            <button class="scroll-btn left-btn">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button class="scroll-btn right-btn">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

    </div>
</section>


<script>
    const scrollContainer = document.getElementById("partnersScroll");
    const leftBtn = document.querySelector(".left-btn");
    const rightBtn = document.querySelector(".right-btn");

    leftBtn.addEventListener("click", () => {
        scrollContainer.scrollBy({ left: -260, behavior: "smooth" });
    });

    rightBtn.addEventListener("click", () => {
        scrollContainer.scrollBy({ left: 260, behavior: "smooth" });
    });

    scrollContainer.addEventListener("wheel", (e) => {
        scrollContainer.scrollLeft += e.deltaY;
    });


</script>