<link rel="stylesheet" href="~/css/partners.css" asp-append-version="true" />
<section class="partners-section">
    <div class="partners-wrapper">

        <div class="partners-header">
            <h2>@Localizer["TrustedFinancialNetwork"]</h2>
            @* <div class="partners-line"></div> *@
            <p>@Localizer["PoweringGrowth"]</p>
        </div>

        <div class="partners-scroll" id="partnersScroll">

            <div class="partner-card banks">
                <i class="fa-solid fa-building-columns"></i>
                <h4>@Localizer["Banks"]</h4>
                <p>@Localizer["BanksDescription"]</p>
                <span>@Localizer["ReadMore"]</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card nbfc">
                <i class="fa-solid fa-chart-line"></i>
                <h4>@Localizer["NBFC"]</h4>
                <p>@Localizer["NBFCDescription"]</p>
                <span>@Localizer["ReadMore"]</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card sidbi">
                <i class="fa-solid fa-landmark"></i>
                <h4>@Localizer["SIDBI"]</h4>
                <p>@Localizer["SIDBIDescription"]</p>
                <span>@Localizer["ReadMore"]</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card coop">
                <i class="fa-solid fa-handshake"></i>
                <h4>@Localizer["CoOperatives"]</h4>
                <p>@Localizer["CoOperativesDescription"]</p>
                <span>@Localizer["ReadMore"]</span>
            </div>

            <div class="connector">
                <i class="fa-solid fa-link"></i>
            </div>

            <div class="partner-card investors">
                <i class="fa-solid fa-user-tie"></i>
                <h4>@Localizer["Investors"]</h4>
                <p>@Localizer["InvestorsDescription"]</p>
                <span>@Localizer["ReadMore"]</span>
            </div>

        </div>

        <div class="scroll-controls">
            <button class="scroll-btn left-btn">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <button class="scroll-btn right-btn">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

    </div>
</section>
<script>
    const scrollContainer = document.getElementById("partnersScroll");
    const leftBtn = document.querySelector(".left-btn");
    const rightBtn = document.querySelector(".right-btn");

    leftBtn.addEventListener("click", () => {
        scrollContainer.scrollBy({ left: -260, behavior: "smooth" });
    });

    rightBtn.addEventListener("click", () => {
        scrollContainer.scrollBy({ left: 260, behavior: "smooth" });
    });

    scrollContainer.addEventListener("wheel", (e) => {
        scrollContainer.scrollLeft += e.deltaY;
    });


</script>