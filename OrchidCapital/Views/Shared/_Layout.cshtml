<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrchidCapital</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          asp-append-version="true" />
    <link href="~/Admin/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toastr.min.css" asp-append-version="true" />
</head>

<body id="common-uportal-wrapper">
    <div class="overlay" id="overlay"></div>
    <div class="dashboard">
        <aside class="sidebar" id="sidebar">
            @* <button class="close-sidebar" id="closeSidebar">
                <i class="fa-solid fa-xmark"></i>
            </button> *@
            <!-- FIXED LOGO -->
            @* <div class="sidebar-header">
                <div class="logo">OC</div>
            </div> *@
            <!-- SCROLLABLE MENU -->
            @* <div class="sidebar-menu">
                <partial name="_AdminMenu" />
            </div> *@
        </aside>
        <div class="main">
            <div class="language-wrapper">
                <partial name="_LanguageSelector" />
            </div>
            @* <partial name="_AdminHeader" /> *@
            <section class="content">
                @RenderBody()
            </section>
            <div id="customTooltip"></div>
        </div>
        @* <partial name="_AdminFooter" />
        <partial name="_ValidationScriptsPartial" />
        <partial name="_AdminScripts" /> *@
        @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>

</html>