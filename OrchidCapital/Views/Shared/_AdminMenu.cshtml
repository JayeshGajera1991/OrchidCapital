@using System.Security.Claims;
@using Newtonsoft.Json;
@{
    List<MenuItemVm> menuItems = new List<MenuItemVm>();
    var claimsIdentity = User.Identity as ClaimsIdentity;
    var userData = claimsIdentity?.FindFirst(ClaimTypes.UserData)?.Value;
    if (!string.IsNullOrEmpty(userData))
    {
        menuItems = JsonConvert.DeserializeObject<List<MenuItemVm>>(Encryption.Decrypt(Environment.GetEnvironmentVariable("USR_ENC_KEY"),userData));
    }
    var groupedMenu = menuItems.GroupBy(x => x.Section).ToList();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

@foreach (var group in groupedMenu)
{
     var iconName = group.FirstOrDefault()?.IconName;
      var isActiveGroup = group.Any(item =>
        string.Equals(item.Controller, currentController, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(item.Action, currentAction, StringComparison.OrdinalIgnoreCase)
    );
    if (group.Any(x => x.IsSelected == "checked"))
    {
        <div class="menu-item">

            <div class="menu @(isActiveGroup ? "active" : "")">
                <i class="@iconName"></i>
                <span>@group.Key</span>
            </div>

            <div class="submenu">
                <div class="submenu-header">
                    @group.Key
                </div>
                @foreach (var item in group)
                {
                    if (item.IsSelected == "checked")
                    {
                        <a href="@Url.Action(item.Action, item.Controller)">
                            <i class="@item.Icon"></i>
                            @item.PageName
                        </a>
                    }
                }

            </div>
        </div>
    }
}