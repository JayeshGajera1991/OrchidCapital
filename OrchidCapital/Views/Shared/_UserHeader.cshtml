<link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
@{
    var header = ViewBag.HeaderData as AllModuleListRequest;
}
<div class="oc-offer-bar">
    <div class="oc-offer-text">
        🎉 @Localizer["LimitedTimeOffer"] –
        @Localizer["HomeLoanProcessingFeeWaiver"]
        @Localizer["ApplyNow"] →
    </div>
</div>
<header class="top-header">
    <div class="header-left">
        <a href="@Url.Action("Index", "Home")"><img src="~/Images/logo3.png" alt="Logo" class="logo"></a>
    </div>
    <nav class="header-nav">
        <div class="white-menu">
            <div class="white-menu-left">
                <a href="@Url.Action("Index", "Home")">@Localizer["Home"]</a>
                <div class="business-trigger">
                    <a href="#" class="business-link" id="businessTrigger">
                        @Localizer["Business"]
                        <i class="fa-solid fa-chevron-down biz-arrow"></i>
                    </a>
                    <partial name="_UserSuperBusinessMega" />
                </div>
                <a href="@Url.Action("AboutUs", "Home")">@Localizer["AboutUs"]</a>
                <a href="@Url.Action("ContactUs", "Home")">@Localizer["ContactUs"]</a>
            </div>
            <div class="white-menu-right">
                <div class="white-lang">
                    @* <i class="fa-solid fa-globe"></i> *@
                    <div class="language-wrapper">
                        <partial name="_LanguageSelector" />
                    </div>
                </div>

                <div class="white-social">
                    <a href="@Url.Action("Login", "Login")"><i class="fa-solid fa-user"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                </div>
            </div>
        </div>
        <div class="purple-submenu">
            <a href="#">
                <i class="fa-solid fa-shield-halved"></i>
                @Localizer["SecureLoans"]
            </a>

            <a href="#">
                <i class="fa-solid fa-bolt"></i>
                @Localizer["UnsecureLoans"]
            </a>

            <a href="#">
                <i class="fa-solid fa-chart-line"></i>
                @Localizer["CreditScore"]
            </a>

            <a href="#">
                <i class="fa-solid fa-calculator"></i>
                @Localizer["Calculations"]
            </a>

            <a href="#">
                <i class="fa-solid fa-book-open"></i>
                @Localizer["Learn"]
            </a>

            <a href="#">
                <i class="fa-solid fa-folder"></i>
                @Localizer["Resources"]
            </a>
        </div>
    </nav>

    <div class="mobile-right">
        <div class="mobile-white-menu-right">
            <div class="mobile-white-lang">
                <div class="mobile-language-wrapper">
                    <partial name="_LanguageSelectorMobile" />
                </div>
                <a href="#"> <i class="fa-solid fa-phone"></i></a>
                <a href="@Url.Action("Login", "Login")"> <i class="fa-solid fa-user"></i></a>
            </div>
        </div>
        <button class="call-btn">
            <i class="fa-brands fa-facebook-f"></i>
        </button>
        <button class="call-btn">
            <i class="fa-brands fa-linkedin-in"></i>
        </button>
        <button class="call-btn">
            <i class="fa-brands fa-instagram"></i>
        </button>
        <button class="call-btn">
            <i class="fa-brands fa-x-twitter"></i>
        </button>
        <button class="hamburger-btn" id="hamburgerBtn">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
</header>
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-panel" id="mobilePanel">
    <div class="mobile-panel-header">
        <div class="mobile-brand">
            @* <a href="@Url.Action("Index", "Home")"><img src="~/Images/logo3.png" alt="Logo" class=""></a> *@
            <div class="mobile-brand-text">
                <strong>Orchid Capital</strong>
                <span>@Localizer["PremiumFinancialServices"]</span>
            </div>
        </div>
        <div class="mobile-close" id="mobileClose">
            <i class="fa-solid fa-xmark"></i>
        </div>
    </div>
    <div class="mobile-menu">
        <div class="mobile-item">
            <span onclick="window.location.href='@Url.Action("Index", "Home")'">@Localizer["Home"]</span>
        </div>
        <div class="mobile-item" id="mobileBusiness">
            <span>@Localizer["Business"]</span>
            <i class="fa-solid fa-chevron-down"></i>
        </div>
        <div class="mobile-submenu">
            @if (header != null)
            {
                foreach (BankServiceListModel item in header.ProductsList)
                {
                    <a href="@Url.Action("UserRequest", "Home")" data-desc="@item.Descriptions">@item.ProductName</a>
                }
            }
        </div>
        <div class="mobile-item">
            <span onclick="window.location.href='@Url.Action("AboutUs", "Home")'">@Localizer["AboutUs"]</span>
        </div>
        <div class="mobile-item">
            <span onclick="window.location.href='@Url.Action("ContactUs", "Home")'">@Localizer["ContactUs"]</span>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const trigger = document.getElementById("businessTrigger");
        const panel = document.getElementById("businessPanel");
        let closeTimeout;

        if (!trigger || !panel) return;

        function openPanel() {
            clearTimeout(closeTimeout);
            panel.classList.add("active");
            trigger.classList.add("active");
        }

        function closePanel() {
            closeTimeout = setTimeout(() => {
                panel.classList.remove("active");
                trigger.classList.remove("active");
            }, 180); // small delay for smooth UX
        }

        // Hover on menu
        trigger.addEventListener("mouseenter", openPanel);
        trigger.addEventListener("mouseleave", closePanel);

        // Hover on panel
        panel.addEventListener("mouseenter", openPanel);
        panel.addEventListener("mouseleave", closePanel);

    });
</script>

<script>
    const toggle = document.getElementById("aboutToggle");
    const panel = document.getElementById("aboutPanel");

    toggle.addEventListener("click", () => {
        panel.classList.toggle("active");
        toggle.classList.toggle("active");   // ⭐ THIS ROTATES ARROW
    });

</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        const hamburger = document.getElementById("hamburgerBtn");
        const panel = document.getElementById("mobilePanel");
        const close = document.getElementById("mobileClose");
        const business = document.getElementById("mobileBusiness");

        if (!hamburger || !panel) return;

        hamburger.addEventListener("click", () => {
            panel.classList.add("active");
        });

        close.addEventListener("click", () => {
            panel.classList.remove("active");
        });

        business.addEventListener("click", () => {
            business.classList.toggle("active");
        });

    });
</script>
<script>
    window.addEventListener("scroll", function () {
        const header = document.querySelector(".top-header");

        if (window.scrollY > 50) {
            header.classList.add("scrolled");
        } else {
            header.classList.remove("scrolled");
        }
    });
</script>