@{
    ViewData["Title"] = "Dashboard";
}
@model OrchidCapital.Models.DashboardCommonModel
<!-- PAGE HEADER -->

<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>Dashboard</h2>
                <p>Welcome back, here's your financial overview</p>
            </div>

            <div class="page-actions"> </div>
        </div>
    </div>
    <!-- KPI CARDS -->
    <div class="role-panel show" id="Dashboard-Master-Panel">
        @if (Model.ToolsCountsList != null && Model.ToolsCountsList.Count > 0)
        {
            foreach (var item in Model.ToolsCountsList)
            {
                <div class="role-form">
                    <div class="kpi-top">
                        <span>@item.MetricName</span>
                        <i class="@item.Icon"></i>
                    </div>
                    <h2>@item.TotalCount</h2>
                    <p class="positive">@item.TotalPer this month</p>
                </div>
            }
        }
    </div>

    <!-- DATA TABLE -->
    <div class="table-header">
        <h3>Recent Transactions</h3>
        <button class="btn btn-orange" data-tooltip="View All"><i class="fa-solid fa-table-cells"></i></button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Ravi Patel</td>
                <td>Loan</td>
                <td>₹50,000</td>
                <td><span class="status approved">Approved</span></td>
                <td>22 Apr 2026</td>
            </tr>
            <tr>
                <td>Neha Shah</td>
                <td>Deposit</td>
                <td>₹12,000</td>
                <td><span class="status pending">Pending</span></td>
                <td>21 Apr 2026</td>
            </tr>
            <tr>
                <td>Amit Kumar</td>
                <td>Withdrawal</td>
                <td>₹8,500</td>
                <td><span class="status rejected">Rejected</span></td>
                <td>20 Apr 2026</td>
            </tr>
        </tbody>
    </table>

</div>
<script>
    localStorage.clear();
    sessionStorage.clear();
</script>