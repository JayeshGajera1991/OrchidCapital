@using OrchidCapital.Helper
@using System.Security.Cryptography
@model OrchidCapital.Models.LoginViewModel
@using System.Security.Cryptography
@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orchid Capital Login</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="@Url.Content("~/Admin/css/admin_login.css")" asp-append-version="true" />
</head>

<body class="orchid-login-page">
  <main class="login-shell">
    <section class="brand-panel">
      <div class="brand-content">
        <div class="logo-wrapper">
          <img src="~/Images/logo.png" alt="Orchid Capital" class="orchid-logo">
        </div>
        <div class="brand-copy">
          <span class="trusted-badge">
            <i class="fa-solid fa-shield-halved"></i>
            Secure Financial Platform
          </span>
          <h1>Finance with confidence.</h1>
          <p>
            Secure access to your Orchid Capital account,
            designed for modern financial management.
          </p>
        </div>
        <div class="security-points">
          <div class="security-point">
            <span class="point-icon">
              <i class="fa-solid fa-lock"></i>
            </span>
            <div>
              <strong>Bank-level protection</strong>
              <small>Your information is protected with modern security controls.</small>
            </div>
          </div>
          <div class="security-point">
            <span class="point-icon">
              <i class="fa-solid fa-chart-line"></i>
            </span>
            <div>
              <strong>Smart financial tools</strong>
              <small>Manage loans, accounts, and financial activity in one place.</small>
            </div>
          </div>
          <div class="security-point">
            <span class="point-icon">
              <i class="fa-solid fa-headset"></i>
            </span>
            <div>
              <strong>Dedicated support</strong>
              <small>Get help when you need it from the Orchid Capital team.</small>
            </div>
          </div>
        </div>
      </div>
      <div class="brand-footer">
        <span>© @DateTime.Now.Year Orchid Capital</span>
        <span class="footer-dot"></span>
        <span>Secure banking access</span>
      </div>
    </section>
    <section class="form-panel">
      <div class="form-panel-top">
        <span class="secure-status" onclick="location.href='@Url.Action("Index", "Home")'" style="cursor: pointer;">
          <i class="fa-solid fa-house"></i>
          Go to Home
        </span>
        <span class="secure-status">
          <i class="fa-solid fa-lock"></i>
          Secure sign in
        </span>
      </div>
      <div class="login-box">
        <div class="login-heading">
          <h2>Welcome back</h2>
          <p>Sign in to continue to your account.</p>
        </div>
        <form action="/Login/Login" autocomplete="off" class="login-form" id="loginForm" method="post" novalidate>
          <div class="input-group">
            <label for="UserName">Username</label>
            <div class="input-field">
              <i class="fa-regular fa-user"></i>
              @Html.TextBoxFor(m => m.UserName, new
              {
                @class = "form-control",
                placeholder = "Enter username",
                autocomplete = "username"
              })
            </div>
            @Html.ValidationMessageFor(m => m.UserName, " ", new { @class = "text-danger" })
          </div>

          <div class="input-group">
            <div class="label-row">
              <label for="Password">Password</label>
              <a href="@Url.Action("ForgotPassword", "Admin")">Forgot password?</a>
            </div>

            <div class="input-field">
              <i class="fa-solid fa-lock"></i>
              @Html.PasswordFor(m => m.Password, new
              {
                @class = "form-control",
                placeholder = "Enter password",
                spellcheck = "false",
                autocorrect = "off",
                autocomplete = "current-password"
              })
              <button type="button" class="toggle-password" aria-label="Show password" onclick="togglePassword()">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
            @Html.ValidationMessageFor(m => m.Password, " ", new { @class = "text-danger" })
          </div>

          <label class="remember-option">
            @Html.CheckBoxFor(m => m.RememberMe)
            <span class="custom-check">
              <i class="fa-solid fa-check"></i>
            </span>
            <span>Keep me signed in</span>
          </label>
          @if (!string.IsNullOrEmpty(Model.ErrorMessage))
          {
            <div style="color: red;" role="alert">
              @Model.ErrorMessage
            </div>
            <br />
          }
          <button class="login-btn" type="submit" id="btnLogin">
            <span>Sign in securely</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>
        <div class="login-security-note">
          <i class="fa-solid fa-shield-heart"></i>
          <span>Your login is encrypted and protected.</span>
        </div>
      </div>

      <div class="form-panel-footer">
        <span>Need help?</span>
        <a href="@Url.Action("ContactUs","Home")">Contact support</a>
      </div>
    </section>
  </main>
  <script src="@Url.Content("~/js/jquery-3.7.1.min.js")"></script>
  <script src="@Url.Content("~/js/jquery.validate.min.js")"></script>
  <script src="@Url.Content("~/js/jquery.validate.unobtrusive.min.js")"></script>
  <script src="@Url.Content("~/js/jsencrypt.min.js")"></script>
  <script>
    history.pushState(null, "", location.href);

    window.onpopstate = function () {
    history.go(1);
    };
       @* document.addEventListener("keydown", function (e) {
                if (
                    e.key === "F12" ||
                    (e.ctrlKey && e.shiftKey && ["I", "J", "C"].includes(e.key.toUpperCase())) ||
                    (e.ctrlKey && ["U", "S"].includes(e.key.toUpperCase()))
                ) {
                    e.preventDefault();
                }
            });

            document.addEventListener("contextmenu", function (e) {
                e.preventDefault();
            }); *@
    const publicKeyPem = `@Html.Raw(Model.PublicKey)`;
    function encryptPassword(password) {
    var encrypt = new JSEncrypt();
    encrypt.setPublicKey(publicKeyPem);
    var encrypted = encrypt.encrypt(password);
    return encrypted;
    }
    $(document).ready(function () {
    $(function () {
    $("#loginForm").submit(function (event) {
    $("#loginForm").removeData("validator");
    $("#loginForm").removeData("unobtrusiveValidation");
    $.validator.unobtrusive.parse($("#loginForm"));
    event.preventDefault();
    if ($("#loginForm").valid()) {
    const password = $('#Password').val();
    const encryptedPassword = encryptPassword(password);
    $("#Password").val("*******");
    $("#loginForm").append('<input type="hidden" id="hdnEncryptedPassword" name="hdnEncryptedPassword" value="' + encryptedPassword + '" />');
    var rememberMeChecked = $("#RememberMe").is(":checked");
    if (rememberMeChecked) {
    $("#loginForm").append('<input type="hidden" name="hdnRememberMe" value="true" />');
    } else {
    $("#loginForm").append('<input type="hidden" name="hdnRememberMe" value="false" />');
    }
    this.submit();
    }
    });
    });
    });

    function togglePassword() {
    const pass = document.getElementById("Password");
    const button = document.querySelector(".toggle-password");
    const icon = button.querySelector("i");

    if (pass.type === "password") {
    pass.type = "text";
    icon.classList.replace("fa-eye", "fa-eye-slash");
    button.setAttribute("aria-label", "Hide password");
    } else {
    pass.type = "password";
    icon.classList.replace("fa-eye-slash", "fa-eye");
    button.setAttribute("aria-label", "Show password");
    }
    }
  </script>
</body>

</html>