@model OrchidCapital.Models.ChangePasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orchid Capital</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Admin/css/admin_login.css")" asp-append-version="true" />
</head>

<body class="orchid-login-page">
    <main class="login-shell">
        <section class="brand-panel">
            <div class="brand-content">
                <div class="logo-wrapper">
                    <img src="~/Images/logo.png" alt="Orchid Capital" class="orchid-logo">
                </div>
                <div class="brand-copy">
                    <span class="trusted-badge">
                        <i class="fa-solid fa-shield-halved"></i>
                        Secure Financial Platform
                    </span>
                    <h1>Finance with confidence.</h1>
                    <p>
                        Secure access to your Orchid Capital account,
                        designed for modern financial management.
                    </p>
                </div>
                <div class="security-points">
                    <div class="security-point">
                        <span class="point-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <div>
                            <strong>Bank-level protection</strong>
                            <small>Your information is protected with modern security controls.</small>
                        </div>
                    </div>
                    <div class="security-point">
                        <span class="point-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>
                        <div>
                            <strong>Smart financial tools</strong>
                            <small>Manage loans, accounts, and financial activity in one place.</small>
                        </div>
                    </div>
                    <div class="security-point">
                        <span class="point-icon">
                            <i class="fa-solid fa-headset"></i>
                        </span>
                        <div>
                            <strong>Dedicated support</strong>
                            <small>Get help when you need it from the Orchid Capital team.</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="brand-footer">
                <span>© @DateTime.Now.Year Orchid Capital</span>
                <span class="footer-dot"></span>
                <span>Secure banking access</span>
            </div>
        </section>
        <section class="form-panel">
            <div class="form-panel-top">
                <span class="secure-status" onclick="location.href='@Url.Action("Login", "Login")'"
                      style="cursor: pointer;">
                    <i class="fa-solid fa-house"></i>
                    Go to Login
                </span>
                <span class="secure-status">
                    <i class="fa-solid fa-lock"></i>
                    Secure sign in
                </span>
            </div>

            <div class="login-box">
                <div class="login-heading">
                    <h2>Change Password</h2>
                    <p>Change Password to access your secure dashboard</p>
                </div>
                @using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post, new
                {
                    @class = "login-form",
                    id =
                      "loginForm"
                }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="input-group">
                        <label for="CurrentPassword">Current Password</label>
                        <div class="input-field">
                            <i class="fa-solid fa-lock"></i>
                            @Html.HiddenFor(m => m.UserName)
                            @Html.HiddenFor(m => m.UserRole)
                            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", placeholder = "Enter password" })
                            <button type="button" class="toggle-password" aria-label="Show password"
                                    onclick="togglePassword('CurrentPassword');">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.CurrentPassword, " ", new { @class = "text-danger" })
                    </div>

                    <div class="input-group">
                        <label for="NewPassword">New Password</label>
                        <div class="input-field">
                            <i class="fa-solid fa-lock"></i>
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter password" })
                            <button type="button" class="toggle-password" aria-label="Show password"
                                    onclick="togglePassword('NewPassword');">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.NewPassword, " ", new { @class = "text-danger" })
                    </div>

                    <div class="input-group">
                        <label for="ConfirmPassword">Confirm Password</label>
                        <div class="input-field">
                            <i class="fa-solid fa-lock"></i>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Enter password" })
                            <button type="button" class="toggle-password" aria-label="Show password"
                                    onclick="togglePassword('ConfirmPassword');">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, " ", new { @class = "text-danger" })
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div style="color: red;" role="alert">
                            @Model.ErrorMessage
                        </div>
                        <br />
                    }
                    <button class="login-btn" type="submit" id="btnLogin">Change Password</button>
                }
                <div class="login-security-note">
                    <i class="fa-solid fa-shield-heart"></i>
                    <span>Your login is encrypted and protected.</span>
                </div>
            </div>

            <div class="form-panel-footer">
                <span>Need help?</span>
                <a href="mailto:support@orchidcapital.com">Contact support</a>
            </div>
        </section>

    </main>
    <script src="@Url.Content("~/js/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.validate.unobtrusive.min.js")"></script>
    <script src="@Url.Content("~/js/jsencrypt.min.js")"></script>
    <script>
        history.pushState(null, "", location.href);

        window.onpopstate = function () {
        history.go(1);
        };
           @* document.addEventListener("keydown", function (e) {
                if (
                    e.key === "F12" ||
                    (e.ctrlKey && e.shiftKey && ["I", "J", "C"].includes(e.key.toUpperCase())) ||
                    (e.ctrlKey && ["U", "S"].includes(e.key.toUpperCase()))
                ) {
                    e.preventDefault();
                }
            });

            document.addEventListener("contextmenu", function (e) {
                e.preventDefault();
            }); *@
        const publicKeyPem = `@Html.Raw(Model.PublicKey)`;
        function encryptPassword(password) {
        var encrypt = new JSEncrypt();
        encrypt.setPublicKey(publicKeyPem);
        var encrypted = encrypt.encrypt(password);
        return encrypted;
        }
        $(document).ready(function () {
        $("#loginForm").submit(function (event) {
        $("#loginForm").removeData("validator");
        $("#loginForm").removeData("unobtrusiveValidation");
        $.validator.unobtrusive.parse($("#loginForm"));
        event.preventDefault();
        if ($("#loginForm").valid()) {
        const CurrentPassword = $('#CurrentPassword').val();
        const encryptedCurrentPassword = encryptPassword(CurrentPassword);
        const NewPassword = $('#NewPassword').val();
        const encryptedNewPassword = encryptPassword(NewPassword);
        $("#CurrentPassword").val("*******");
        $("#NewPassword").val("*******");
        $("#ConfirmPassword").val("*******");
        $("#loginForm").append('<input type="hidden" id="hdnEncryptedCurrentPassword" name="hdnEncryptedCurrentPassword" value="' + encryptedCurrentPassword + '" />');
        $("#loginForm").append('<input type="hidden" id="hdnEncryptedNewPassword" name="hdnEncryptedNewPassword" value="' + encryptedNewPassword + '" />');
        this.submit();
        }
        });
        });

        function togglePassword(id) {
        const pass = document.getElementById(id);
        const button = document.querySelector(".toggle-password");
        const icon = button.querySelector("i");

        if (pass.type === "password") {
        pass.type = "text";
        icon.classList.replace("fa-eye", "fa-eye-slash");
        button.setAttribute("aria-label", "Hide password");
        } else {
        pass.type = "password";
        icon.classList.replace("fa-eye-slash", "fa-eye");
        button.setAttribute("aria-label", "Show password");
        }
        }
    </script>
</body>

</html>