@model OrchidCapital.Models.TwoFactorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orchid Capital Login</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="@Url.Content("~/Admin/css/admin_login.css")" asp-append-version="true" />
</head>

<body>

    <div class="left">
        <div class="brand">
            <h1>Orchid Capital</h1>
            <p>Secure & Smart Financial Management</p>
        </div>

        <div class="features">
            <div class="feature"><i class="fa-solid fa-shield-halved"></i> Bank-grade Security</div>
            <div class="feature"><i class="fa-solid fa-chart-line"></i> Advanced Analytics</div>
            <div class="feature"><i class="fa-solid fa-user-lock"></i> Role-based Access Control</div>
            <div class="feature"><i class="fa-solid fa-database"></i> End-to-End Encryption</div>
        </div>
    </div>

    <div class="right">
        <div class="login-box">
            <h2>Two Factor Authentication</h2>
            <p>Enter the verification code from your authenticator app</p>
            @using (Html.BeginForm("TwoFactorVerification", "Login", FormMethod.Post, new
            {
                @class = "login-form",
                id =
                                          "loginForm"
            }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="input-group">
                    <label>Verification Code</label>
                    <div class="input-field">
                        <i class="fa-solid fa-key"></i>
                        @Html.HiddenFor(m => m.UserName)
                        @Html.HiddenFor(m => m.SecretKey)
                        @Html.TextBoxFor(m => m.AuthCode, new { @class = "form-control textboxallownumeric", placeholder = "Enter verification code",maxlength="6" })
                    </div>
                    @Html.ValidationMessageFor(m => m.AuthCode, " ", new { @class = "text-danger" })
                </div>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div style="color: red;" role="alert">
                        @Model.ErrorMessage
                    </div>
                    <br />
                }
                <button class="login-btn" type="submit" id="btnLogin">Verify</button>
            }
            <div class="security-info">
                <i class="fa-solid fa-shield"></i>
                Protected with enterprise-grade encryption
            </div>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
    <script>
            $(document).ready(function () {
                $("#loginForm").submit(function (event) {
                    $("#loginForm").removeData("validator");
                    $("#loginForm").removeData("unobtrusiveValidation");
                    $.validator.unobtrusive.parse($("#loginForm"));
                    event.preventDefault();
                    if ($("#loginForm").valid()) {
                        this.submit();
                    }
                });
            });
            $(document).on('keypress','.textboxallownumeric', function (e) {
                if (e.which < 48 || e.which > 57) {
                    return false;
                }
            });
    </script>
</body>

</html>