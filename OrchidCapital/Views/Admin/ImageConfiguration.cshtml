@{
    ViewData["Title"] = "Image Configuration";
}
<link rel="stylesheet" href="~/Admin/css/admin_roles.css" asp-append-version="true" />
<div class="role-panel" id="ImageConfiguration-Master-Panel">
    <div class="role-form" id="add_image_configuration_form_wrapper">
    </div>
</div>

<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>Image Configurations</h2>
                <p>Manage image configuration information and settings</p>
            </div>
        </div>
        <div class="customer-toolbar">
            <div class="search-box custom-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       onkeyup="APortalModule._APortalMaster.InputBoxSearch(event,this,APortalImageConfiguration._APortalImageConfiguration)"
                       id="imageConfigurationsSearch" placeholder="Search image configurations..." />
                <button type="button" class="search_close_btn btn hidden"
                        onclick="APortalModule._APortalMaster.SearchBoxReset('imageConfigurationsSearch',APortalImageConfiguration._APortalImageConfiguration)">X</button>
            </div>
            <select id="statusFilter" class="sort-dropdown"
                    onchange="APortalModule._APortalMaster.StatusChangeEvent(this,APortalImageConfiguration._APortalImageConfiguration)">
                <option value="2" selected="selected">All</option>
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
            <div class="page-actions tooltip">
                <button class="btn btn-purple"
                        onclick="APortalImageConfiguration._APortalImageConfiguration.ExportToExcel('APortal_ImageConfigMst', 'Image Configurations List');">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="tooltip-text">Export to Excel</span>
                </button>
            </div>
            <div class="page-actions tooltip">
                <button class="btn btn-blue" id="toggleCustomerForm" onclick="APortalImageConfiguration._APortalImageConfiguration.Create();">
                    <i class="fa-solid fa-plus"></i>
                    <span class="tooltip-text">Add Image Configuration</span>
                </button>
            </div>
        </div>
    </div>
    <div class="empty-state" id="emptyCustomerState" style="display:none;">
        <i class="fa-solid fa-users"></i>
        <p>No image configurations available</p>
        <button class="btn btn-blue" onclick="APortalImageConfiguration._APortalImageConfiguration.Create();">
            <i class="fa-solid fa-plus"></i>
            <span class="tooltip-text">Add Image Configuration</span>
        </button>
    </div>

    <!-- TABLE -->
    <div class="table-wrapper scroll-body" id="pageTableWrapper"
         onscroll="APortalModule._APortalMaster.ScrollMore(event,this,APortalImageConfiguration._APortalImageConfiguration)">
        <table id="tblImageConfigurationsList" class="table">
            <thead>
                <tr>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblImageConfigurationsList','Headline',APortalImageConfiguration._APortalImageConfiguration)">
                            Headline
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Headline_ASC active"></i>
                                <i class="fa-solid fa-sort-down Headline_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblImageConfigurationsList','Role',APortalImageConfiguration._APortalImageConfiguration)">
                            Role
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Role_ASC"></i>
                                <i class="fa-solid fa-sort-down Role_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblImageConfigurationsList','Type',APortalImageConfiguration._APortalImageConfiguration)">
                            Type
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Type_ASC"></i>
                                <i class="fa-solid fa-sort-down Type_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblImageConfigurationsList','Description',APortalImageConfiguration._APortalImageConfiguration)">
                            Description
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Description_ASC"></i>
                                <i class="fa-solid fa-sort-down Description_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        Image
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblImageConfigurationsList','IsActive',APortalImageConfiguration._APortalImageConfiguration)">
                            Status
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up IsActive_ASC"></i>
                                <i class="fa-solid fa-sort-down IsActive_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblImageConfigurationsList','CreatedOn',APortalImageConfiguration._APortalImageConfiguration)">
                            Created Date
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up CreatedOn_ASC"></i>
                                <i class="fa-solid fa-sort-down CreatedOn_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody id="imageconfiguration-tbody-render">
                <!-- dynamic -->
            </tbody>
        </table>
    </div>
    <div id="pagination" style="padding: 15px 30px;"></div>
</div>
<script>
    var _loadUrls = function () {
        return {
            create: '@Url.Action("Create", "Admin")',
            list: '@Url.Action("List", "Admin")',
            get: '@Url.Action("Edit", "Admin")',
            status: '@Url.Action("Status", "Admin")',
            delete: '@Url.Action("Delete", "Admin")',
            export: '@Url.Action("ExportToExcelFile", "Admin")'
        };
    }
    window.APortalImageConfiguration = {
        configs: {
            urlBase: '@Utility.GetAppSettings("BasePath")',
            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
@section Scripts {
    <script src="~/Admin/js/ImageConfiguration.js" asp-append-version="true"></script>
}