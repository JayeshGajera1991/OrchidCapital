@model OrchidCapital.Models.UpdatePageDetailsRequest
<h3 id="h3_addPageHeader">Add New Page</h3>
<button type="button" class="btn btn-red close-btn" onclick="APortalModule._APortalCommon.CloseToggle('Pages-Master-Panel','nav_page_form');">
    <i class="fa-solid fa-xmark"></i>
</button>
<form id="nav_page_form" action="@Url.Action("UpdatePagesDetails", "Admin")" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-grid">
        <div class="form-group">
            <label>Menu *</label>
            @Html.DropDownListFor(m => m.MenuId, ViewBag.MenuList as SelectList, "-- Select Menu --", new { @class = "form-control select2", required = "required" })
            @Html.ValidationMessageFor(m => m.MenuId, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Page Name *</label>
            @Html.HiddenFor(m => m.Id) <!-- Hidden field for Page ID -->
            @Html.HiddenFor(m => m.IsActive) <!-- Hidden field for IsActive status -->
            @Html.HiddenFor(m => m.UserName) <!-- Hidden field for UserName -->
            @Html.HiddenFor(m => m.UserRole) <!-- Hidden field for UserRole -->
            @Html.TextBoxFor(m => m.PageName, new { @placeholder = "Enter page name",@class="txtspace",MaxLength="1000" })
            @Html.ValidationMessageFor(m => m.PageName, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Controller *</label>
            @Html.TextBoxFor(m => m.Controller, new { @placeholder = "Enter controller name",@class="txtspace",MaxLength="500" })
            @Html.ValidationMessageFor(m => m.Controller, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Action Name *</label>
            @Html.TextBoxFor(m => m.ActionName, new { @placeholder = "Enter action name",@class="txtspace",MaxLength="500" })
            @Html.ValidationMessageFor(m => m.ActionName, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Page Icon *</label>
            @Html.TextBoxFor(m => m.Icon, new { @placeholder = "Enter page icon",@class="txtspace",MaxLength="100" })
            @Html.ValidationMessageFor(m => m.Icon, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Order Number *</label>
            @Html.TextBoxFor(m => m.OrderNo, new { @placeholder = "Enter order number",@class="txtspace txtnumeric",MaxLength="10" })
            @Html.ValidationMessageFor(m => m.OrderNo, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="action-buttons top-buttons">
        @if (Model.Id == 0)
        {
            <button class="btn btn-red" id="ClearPage" type="button"
                    onclick="APortalModule._APortalMaster.FormDataClear(APortalPages._APortalPages);">
                <i class="fa-solid fa-refresh"></i>
            </button>
        }
        else
        {
            <button class="btn btn-red" id="resetPage" type="button"
                    onclick="APortalModule._APortalMaster.FormDataReset('tblPagesList','@Model.Id');">
                <i class="fa-solid fa-refresh"></i>
            </button>
        }
        <button class="btn btn-green" id="saveCustomer" type="submit"
                onclick="APortalPages._APortalPages.SubmitFormData(event, $('#nav_page_form'));">
            <i class="fa-solid fa-floppy-disk"></i>
        </button>
    </div>
</form>