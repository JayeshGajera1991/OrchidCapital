@model IEnumerable<OrchidCapital.Models.AuditLogListModel>
@{
    if (Model.Count() == 0)
    {
        <tr data-total-records="0" id="0">
            <td colspan="5" style="text-align: center;">No audit logs available.</td>
        </tr>
    }
    else
    {
        foreach (AuditLogListModel item in Model)
        {
            <tr data-total-records="@item.TotalRecords" id="@item.Id">
                <td>@item.CreatedUser</td>
                <td>@item.OperationType</td>
                <td>@item.Entity</td>
                <td>@item.PrimaryKey</td>
                <td>@item.SPName</td>
                <td>@item.OldDataXml</td>
                <td>@item.NewDataXml</td>
                <td>@item.CreatedOn</td>
            </tr>
        }
    }
}