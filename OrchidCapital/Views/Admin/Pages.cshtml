@{
    ViewData["Title"] = "Admin Pages";
    Layout = "_LayoutAdmin";
}
<link rel="stylesheet" href="~/Admin/css/admin_roles.css" asp-append-version="true" />
<div class="role-panel" id="Pages-Master-Panel">
    <div class="role-form" id="add_page_form_wrapper">
    </div>
</div>

<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>Pages</h2>
                <p>Manage page information and settings</p>
            </div>
        </div>
        <div class="customer-toolbar">
            <div class="search-box custom-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       onkeyup="APortalModule._APortalMaster.InputBoxSearch(event,this,APortalPages._APortalPages)"
                       id="pagesSearch" placeholder="Search customers..." />
                <button type="button" class="search_close_btn btn hidden"
                        onclick="APortalModule._APortalMaster.SearchBoxReset('pagesSearch',APortalPages._APortalPages)">X</button>
            </div>
            <select id="statusFilter" class="sort-dropdown select2"
                    onchange="APortalModule._APortalMaster.StatusChangeEvent(this,APortalPages._APortalPages)">
                <option value="2" selected="selected">All</option>
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
            <div class="page-actions tooltip">
                <button class="btn btn-secondary" 
                        onclick="APortalPages._APortalPages.ExportToExcel('APortal_PageMst', 'Pages List');">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="tooltip-text">Export to Excel</span>
                </button>
            </div>
            <div class="page-actions tooltip">
                <button class="btn btn-primary" id="toggleCustomerForm" onclick="APortalPages._APortalPages.Create();">
                    <i class="fa-solid fa-plus"></i>
                    <span class="tooltip-text">Add Page</span>
                </button>
            </div>
        </div>
    </div>
    <div class="empty-state" id="emptyCustomerState" style="display:none;">
        <i class="fa-solid fa-users"></i>
        <p>No pages available</p>
        <button class="btn btn-primary" onclick="APortalPages._APortalPages.Create();">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    <!-- TABLE -->
    <div class="table-wrapper scroll-body" id="pageTableWrapper"
         onscroll="APortalModule._APortalMaster.ScrollMore(event,this,APortalPages._APortalPages)">
        <table id="tblPagesList" class="table">
            <thead>
                <tr>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','MenuName',APortalPages._APortalPages)">
                            Menu Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up MenuName_ASC"></i>
                                <i class="fa-solid fa-sort-down MenuName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','PageName',APortalPages._APortalPages)">
                            Page Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up PageName_ASC active"></i>
                                <i class="fa-solid fa-sort-down PageName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','Controller',APortalPages._APortalPages)">
                            Controller Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Controller_ASC"></i>
                                <i class="fa-solid fa-sort-down Controller_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','ActionName',APortalPages._APortalPages)">
                            Action Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up ActionName_ASC"></i>
                                <i class="fa-solid fa-sort-down ActionName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','Icon',APortalPages._APortalPages)">
                            Icon Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Icon_ASC"></i>
                                <i class="fa-solid fa-sort-down Icon_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','OrderNo',APortalPages._APortalPages)">
                            Order Number
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up OrderNo_ASC"></i>
                                <i class="fa-solid fa-sort-down OrderNo_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','IsActive',APortalPages._APortalPages)">
                            Status
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up IsActive_ASC"></i>
                                <i class="fa-solid fa-sort-down IsActive_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblPagesList','CreatedOn',APortalPages._APortalPages)">
                            Created Date
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up CreatedOn_ASC"></i>
                                <i class="fa-solid fa-sort-down CreatedOn_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody id="page-tbody-render">
                <!-- dynamic -->
            </tbody>
        </table>
    </div>
    <div id="pagination" style="padding: 15px 30px;"></div>
</div>
<script>
    var _loadUrls = function () {
        return {
            create: '@Url.Action("Create", "Admin")',
            list: '@Url.Action("List", "Admin")',
            get: '@Url.Action("Edit", "Admin")',
            status: '@Url.Action("Status", "Admin")',
            delete: '@Url.Action("Delete", "Admin")',
            export: '@Url.Action("ExportToExcelFile", "Admin")'
        };
    }
    window.APortalPages = {
        configs: {
            urlBase: '@Utility.GetAppSettings("BasePath")',
            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
@section Scripts {
    <script src="~/Admin/Js/Pages.js" asp-append-version="true"></script>
}