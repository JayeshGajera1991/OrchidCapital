@model IEnumerable<OrchidCapital.Models.ErrorLogListModel>
@{
    if (Model.Count() == 0)
    {
        <tr data-total-records="0" id="0">
            <td colspan="5" style="text-align: center;">No error logs available.</td>
        </tr>
    }
    else
    {
        foreach (ErrorLogListModel item in Model)
        {
            <tr data-total-records="@item.TotalRecords" id="@item.Id">
                <td>@item.UserName</td>
                <td>@item.ControllerName</td>
                <td>@item.ActionName</td>
                <td>@item.ErrorMessage</td>
                <td>@item.CreatedOn</td>
            </tr>
        }
    }
}