@{
    ViewData["Title"] = "Bank Service";
    Layout = "_LayoutAdmin";
}
<link rel="stylesheet" href="~/Admin/css/admin_roles.css" asp-append-version="true" />
<div class="role-panel" id="BankService-Master-Panel">
    <div class="role-form" id="add_BankService_form_wrapper">
    </div>
</div>

<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>BankService</h2>
                <p>Bank Service information and settings</p>
            </div>
        </div>
        <div class="customer-toolbar">
            <div class="search-box custom-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       onkeyup="APortalModule._APortalMaster.InputBoxSearch(event,this,APortalBankService._APortalBankService)"
                       id="BankServiceSearch" placeholder="Search service..." />
                <button type="button" class="search_close_btn btn hidden"
                        onclick="APortalModule._APortalMaster.SearchBoxReset('BankServiceSearch',APortalBankService._APortalBankService)">X</button>
            </div>
            <select id="statusFilter" class="sort-dropdown select2"
                    onchange="APortalModule._APortalMaster.StatusChangeEvent(this,APortalBankService._APortalBankService)">
                <option value="2" selected="selected">All</option>
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
            <div class="page-actions tooltip">
                <button class="btn btn-secondary"
                        onclick="APortalBankService._APortalBankService.ExportToExcel('APortal_LoanProductMaster', 'Bank Service List');">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="tooltip-text">Export to Excel</span>
                </button>
            </div>
            <div class="page-actions tooltip">
                <button class="btn btn-primary" id="toggleCustomerForm"
                        onclick="APortalBankService._APortalBankService.Create();">
                    <i class="fa-solid fa-plus"></i>
                    <span class="tooltip-text">Add Service</span>
                </button>
            </div>
        </div>
    </div>
    <div class="empty-state" id="emptyCustomerState" style="display:none;">
        <i class="fa-solid fa-users"></i>
        <p>No Service available</p>
        <button class="btn btn-primary" onclick="APortalBankService._APortalBankService.Create();">
            <i class="fa-solid fa-plus"></i>
            <span class="tooltip-text">Add Service</span>
        </button>
    </div>

    <!-- TABLE -->
    <div class="table-wrapper scroll-body" id="BankServiceTableWrapper"
         onscroll="APortalModule._APortalMaster.ScrollMore(event,this,APortalBankService._APortalBankService)">
        <table id="tblBankServiceList" class="table">
            <thead>
                <tr>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','ProductCode',APortalBankService._APortalBankService)">
                            Product Code
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up ProductCode_ASC active"></i>
                                <i class="fa-solid fa-sort-down ProductCode_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','ProductName',APortalBankService._APortalBankService)">
                            Product Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up ProductName_ASC"></i>
                                <i class="fa-solid fa-sort-downProductName_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','LoanType',APortalBankService._APortalBankService)">
                            Loan Type
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up LoanType_ASC"></i>
                                <i class="fa-solid fa-sort-down LoanType_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','MinAmount',APortalBankService._APortalBankService)">
                            Min Amount
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up MinAmount_ASC"></i>
                                <i class="fa-solid fa-sort-down MinAmount_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','MaxAmount',APortalBankService._APortalBankService)">
                            Max Amount
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up MaxAmount_ASC"></i>
                                <i class="fa-solid fa-sort-down MaxAmount_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','MinTenure',APortalBankService._APortalBankService)">
                            Min Tenure
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up MinTenure_ASC"></i>
                                <i class="fa-solid fa-sort-down MinTenure_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','MaxTenure',APortalBankService._APortalBankService)">
                            Max Tenure
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up MaxTenure_ASC"></i>
                                <i class="fa-solid fa-sort-down MaxTenure_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','InterestType',APortalBankService._APortalBankService)">
                            Interest Type
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up InterestType_ASC"></i>
                                <i class="fa-solid fa-sort-down InterestType_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','DefaultInterestRate',APortalBankService._APortalBankService)">
                            Default Interest Rate
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up DefaultInterestRate_ASC"></i>
                                <i class="fa-solid fa-sort-down DefaultInterestRate_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','ProcessingFeePercent',APortalBankService._APortalBankService)">
                            Processing Fee Percent
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up ProcessingFeePercent_ASC"></i>
                                <i class="fa-solid fa-sort-down ProcessingFeePercent_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','PenaltyInterest',APortalBankService._APortalBankService)">
                            Penalty Interest
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up PenaltyInterest_ASC"></i>
                                <i class="fa-solid fa-sort-down PenaltyInterest_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','GraceDays',APortalBankService._APortalBankService)">
                            Grace Days
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up GraceDays_ASC"></i>
                                <i class="fa-solid fa-sort-down GraceDays_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','IsActive',APortalBankService._APortalBankService)">
                            Status
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up IsActive_ASC"></i>
                                <i class="fa-solid fa-sort-down IsActive_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                           onclick="APortalModule._APortalMaster.Sorting('tblBankServiceList','CreatedOn',APortalBankService._APortalBankService)">
                            Created Date
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up CreatedOn_ASC"></i>
                                <i class="fa-solid fa-sort-down CreatedOn_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody id="BankService-tbody-render">
                <!-- dynamic -->
            </tbody>
        </table>
    </div>
    <div id="pagination" style="padding: 15px 30px;"></div>
</div>
<script>
    var _loadUrls = function () {
        return {
            create: '@Url.Action("Create", "Admin")',
            list: '@Url.Action("List", "Admin")',
            get: '@Url.Action("Edit", "Admin")',
            status: '@Url.Action("Status", "Admin")',
            delete: '@Url.Action("Delete", "Admin")',
            export: '@Url.Action("ExportToExcelFile", "Admin")'
        };
    }
    window.APortalBankService = {
        configs: {
            urlBase: '@Utility.GetAppSettings("BasePath")',
            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
@section Scripts {
    <script src="~/Admin/Js/BankService.js" asp-append-version="true"></script>
}