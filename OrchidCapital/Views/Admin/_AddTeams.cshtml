@model OrchidCapital.Models.UpdateTeamDetailsRequest
<h3 id="h3_addTeamHeader">Add New Team</h3>
<button type="button" class="btn btn-danger close-btn" onclick="APortalModule._APortalCommon.CloseToggle('Teams-Master-Panel','nav_teams_form');">
    <i class="fa-solid fa-xmark"></i>
</button>
<form id="nav_teams_form" action="@Url.Action("UpdateTeams", "Admin")" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-grid">
        <div class="form-group">
            <label>Full Name *</label>
            @Html.HiddenFor(m => m.Id) <!-- Hidden field for Page ID -->
            @Html.HiddenFor(m => m.IsActive) <!-- Hidden field for IsActive status -->
            @Html.HiddenFor(m => m.UserName) <!-- Hidden field for UserName -->
            @Html.HiddenFor(m => m.UserRole) <!-- Hidden field for UserRole -->
            @Html.TextBoxFor(m => m.FullName, new { @placeholder = "Enter full name",@class = "txtspace",MaxLength = "500" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Role *</label>
            @Html.TextBoxFor(m => m.Role, new { @placeholder = "Enter role",@class = "txtspace",MaxLength = "100" })
            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Qualification *</label>
            @Html.TextBoxFor(m => m.Qualification, new { @placeholder = "Enter qualification",@class = "txtspace",MaxLength = "100" })
            @Html.ValidationMessageFor(m => m.Qualification, "", new { @class = "text-danger" })
        </div>
         <div class="form-group">
            <label>Headline *</label>
            @Html.TextBoxFor(m => m.Headline, new { @placeholder = "Enter headline",@class = "txtspace",MaxLength = "500" })
            @Html.ValidationMessageFor(m => m.Headline, "", new { @class = "text-danger" })
        </div>
         <div class="form-group full-width">
            <label>Description 1 *</label>
            @Html.TextAreaFor(m => m.Description1, new { @placeholder = "Enter description 1",@class = "txtspace",MaxLength = "1000" })
            @Html.ValidationMessageFor(m => m.Description1, "", new { @class = "text-danger" })
        </div>
         <div class="form-group full-width">
            <label>Description 2 *</label>
            @Html.TextAreaFor(m => m.Description2, new { @placeholder = "Enter description 2",@class = "txtspace",MaxLength = "1000" })
            @Html.ValidationMessageFor(m => m.Description2, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="action-buttons">
        @if (Model.Id == 0)
        {
            <button class="btn btn-danger" id="ClearPage" type="button"
                    onclick="APortalModule._APortalMaster.FormDataClear(APortalTeams._APortalTeams);">
                <i class="fa-solid fa-refresh"></i>
            </button>
        }
        else
        {
            <button class="btn btn-danger" id="resetPage" type="button"
                    onclick="APortalModule._APortalMaster.FormDataReset('tblTeamsList','@Model.Id');">
                <i class="fa-solid fa-refresh"></i>
            </button>
        }
        <button class="btn btn-success" id="saveCustomer" type="submit"
                onclick="APortalTeams._APortalTeams.SubmitFormData(event, $('#nav_teams_form'));">
            <i class="fa-solid fa-floppy-disk"></i>
        </button>
    </div>
</form>