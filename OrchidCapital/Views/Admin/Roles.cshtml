@{
    ViewData["Title"] = "Admin Roles";
    Layout = "_LayoutAdmin";
}
<link rel="stylesheet" href="~/Admin/css/admin_roles.css" asp-append-version="true" />
<div class="role-panel" id="Roles-Master-Panel">
    <div class="role-form" id="add_roles_form_wrapper">
    </div>
</div>

<div class="table-card">
    <div class="table-header">
        <div class="page-header">
            <div>
                <h2>Roles</h2>
                <p>Manage roles information and settings</p>
            </div>
        </div>
        <div class="customer-toolbar">
            <div class="search-box custom-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" onkeyup="APortalModule._APortalMaster.InputBoxSearch(event,this,APortalRoles._APortalRoles)" id="rolesSearch" placeholder="Search role..." />
                <button type="button" class="search_close_btn btn hidden" onclick="APortalModule._APortalMaster.SearchBoxReset('rolesSearch',APortalRoles._APortalRoles)">X</button>
            </div>
            <select id="statusFilter" class="sort-dropdown select2"
                    onchange="APortalModule._APortalMaster.StatusChangeEvent(this,APortalRoles._APortalRoles)">
                <option value="2" selected="selected">All</option>
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
            <div class="page-actions tooltip">
                <button class="btn btn-secondary" onclick="APortalRoles._APortalRoles.ExportToExcel('APortal_RoleMst', 'Roles List');">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="tooltip-text">Export to Excel</span>
                </button>
            </div>
            <div class="page-actions tooltip">
                <button class="btn btn-primary" id="toggleCustomerForm" onclick="APortalRoles._APortalRoles.Create();">
                    <i class="fa-solid fa-plus"></i>
                    <span class="tooltip-text">Add Role</span>
                </button>
            </div>
        </div>
    </div>
    <div class="empty-state" id="emptyCustomerState" style="display:none;">
        <i class="fa-solid fa-users"></i>
        <p>No roles available</p>
        <button class="btn btn-primary" onclick="APortalRoles._APortalRoles.Create();">
            <i class="fa-solid fa-plus"></i>
            <span class="tooltip-text">Add Role</span>
        </button>
    </div>

    <!-- TABLE -->
    <div class="table-wrapper scroll-body" id="rolesTableWrapper"
         onscroll="APortalModule._APortalMaster.ScrollMore(event,this,APortalRoles._APortalRoles)">
        <table id="tblRolesList" class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblRolesList','RolesName',APortalRoles._APortalRoles)">
                            Role Name
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up Role_ASC active"></i>
                                <i class="fa-solid fa-sort-down Role_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable" 
                               onclick="APortalModule._APortalMaster.Sorting('tblRolesList','IsActive',APortalRoles._APortalRoles)">
                            Status
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up IsActive_ASC"></i>
                                <i class="fa-solid fa-sort-down IsActive_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>
                        <a href="javascript:void(0)" class="sortable"
                               onclick="APortalModule._APortalMaster.Sorting('tblRolesList','CreatedOn',APortalRoles._APortalRoles)">
                            Created Date
                            <span class="sort-icons">
                                <i class="fa-solid fa-sort-up CreatedOn_ASC"></i>
                                <i class="fa-solid fa-sort-down CreatedOn_DESC"></i>
                            </span>
                        </a>
                    </th>
                    <th>Created By</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody id="roles-tbody-render">
                <!-- dynamic -->
            </tbody>
        </table>
    </div>
    <div id="pagination" style="padding: 15px 30px;"></div>
</div>
<script>
    var _loadUrls = function () {
        return {
            create: '@Url.Action("Create", "Admin")',
            list: '@Url.Action("List", "Admin")',
            get: '@Url.Action("Edit", "Admin")',
            status: '@Url.Action("Status", "Admin")',
            delete: '@Url.Action("Delete", "Admin")',
            export: '@Url.Action("ExportToExcelFile", "Admin")'
        };
    }
    window.APortalRoles = {
        configs: {
            urlBase: '@Utility.GetAppSettings("BasePath")',
            loginUserName: '@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value',
            loginUserRole: '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value',
            defaultPageSize: 25
        },
        urls: _loadUrls()
    };    
</script>
@section Scripts {
    <script src="~/Admin/Js/Roles.js" asp-append-version="true"></script>
}