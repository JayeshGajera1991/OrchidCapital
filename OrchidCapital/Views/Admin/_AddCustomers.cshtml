@model OrchidCapital.Models.UpdateUserDetailsRequest
@using Microsoft.AspNetCore.Mvc.Rendering;
<h3 id="h3_addCustomerHeader">Add New Customer Details</h3>
<button type="button" class="btn btn-danger close-btn" onclick="APortalModule._APortalCommon.CloseToggle('Customers-Master-Panel','nav_customer_form');">
    <i class="fa-solid fa-xmark"></i>
</button>
<form id="nav_customer_form" action="@Url.Action("UpdateCustomersDetails", "Admin")" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-grid">
        @if(Model.Id != 0)
        {
            <div class="form-group">
                <label>User Name *</label>                
                @Html.TextBoxFor(m => m.CreateUserName, new { @placeholder = "Enter user name",@readonly="true" })
            </div>
        }
        <div class="form-group">
            <label>First Name *</label>
            @Html.HiddenFor(m => m.Id) <!-- Hidden field for User ID -->
            @Html.HiddenFor(m => m.IsActive) <!-- Hidden field for IsActive status -->
            @Html.TextBoxFor(m => m.FirstName, new { @placeholder = "Enter first name", required = "required",@class="txtspace txtchars",MaxLength="500" })
            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Last Name *</label>
            @Html.TextBoxFor(m => m.LastName, new { @placeholder = "Enter last name", required = "required",@class="txtspace txtchars",MaxLength="500" })
            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Email Id *</label>
            @Html.TextBoxFor(m => m.EmailId, new { @placeholder = "Enter email", required = "required",@class="txtspace txtemail",MaxLength="500" })
            @Html.ValidationMessageFor(m => m.EmailId, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Mobile Number *</label>
            @Html.TextBoxFor(m => m.MobileNo, new { @placeholder = "Enter mobile number", required = "required",@class="txtspace txtnumeric",MaxLength="10" })
            @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Emergency Mobile Number *</label>
            @Html.TextBoxFor(m => m.EmergencyMobileNumber, new { @placeholder = "Enter emergency mobile number", required = "required",@class="txtspace txtnumeric",MaxLength="10" })
            @Html.ValidationMessageFor(m => m.EmergencyMobileNumber, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Role *</label>
            @Html.DropDownListFor(m => m.RoleId, ViewBag.Roles as SelectList, "-- Select Role --", new { @class = "form-control select2", required = "required" })
            @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Gender *</label>
           @Html.DropDownListFor(
            m => m.Gender,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "-- Select Gender --", Value = "" },
                new SelectListItem { Text = "Male", Value = "Male" },
                new SelectListItem { Text = "Female", Value = "Female" }
            },
                        new { @class = "form-control select2", required = "required" })
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>DOB *</label>
            @Html.TextBoxFor(m => m.DOB, new { @placeholder = "Enter DOB", required = "required", @class="txtspace",MaxLength="10" })
            @Html.ValidationMessageFor(m => m.DOB, "", new { @class = "text-danger" })
        </div>
        <div class="form-group full-width">
            <label>Address *</label>
            @Html.TextAreaFor(m => m.Address, new { @placeholder = "Enter address", required = "required",@class="txtspace",MaxLength="500" })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Country *</label>
            @Html.DropDownListFor(
            m => m.Country,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "India", Value = "India" }
            },
                        new { @class = "form-control select2", required = "required" })
            @Html.ValidationMessageFor(m => m.Country, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>State *</label>
            @Html.DropDownListFor(
            m => m.State,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "-- Select State --", Value = "" },
                new SelectListItem { Text = "Andhra Pradesh", Value = "Andhra Pradesh" },
                new SelectListItem { Text = "Arunachal Pradesh", Value = "Arunachal Pradesh" },
                new SelectListItem { Text = "Assam", Value = "Assam" },
                new SelectListItem { Text = "Bihar", Value = "Bihar" },
                new SelectListItem { Text = "Chhattisgarh", Value = "Chhattisgarh" },
                new SelectListItem { Text = "Goa", Value = "Goa" },
                new SelectListItem { Text = "Gujarat", Value = "Gujarat" },
                new SelectListItem { Text = "Haryana", Value = "Haryana" },
                new SelectListItem { Text = "Himachal Pradesh", Value = "Himachal Pradesh" },
                new SelectListItem { Text = "Jharkhand", Value = "Jharkhand" },
                new SelectListItem { Text = "Karnataka", Value = "Karnataka" },
                new SelectListItem { Text = "Kerala", Value = "Kerala" },
                new SelectListItem { Text = "Madhya Pradesh", Value = "Madhya Pradesh" },
                new SelectListItem { Text = "Maharashtra", Value = "Maharashtra" },
                new SelectListItem { Text = "Manipur", Value = "Manipur" },
                new SelectListItem { Text = "Meghalaya", Value = "Meghalaya" },
                new SelectListItem { Text = "Mizoram", Value = "Mizoram" },
                new SelectListItem { Text = "Nagaland", Value = "Nagaland" },
                new SelectListItem { Text = "Odisha", Value = "Odisha" },
                new SelectListItem { Text = "Punjab", Value = "Punjab" },
                new SelectListItem { Text = "Rajasthan", Value = "Rajasthan" },
                new SelectListItem { Text = "Sikkim", Value = "Sikkim" },
                new SelectListItem { Text = "Tamil Nadu", Value = "Tamil Nadu" },
                new SelectListItem { Text = "Telangana", Value = "Telangana" },
                new SelectListItem { Text = "Tripura", Value = "Tripura" },
                new SelectListItem { Text = "Uttar Pradesh", Value = "Uttar Pradesh" },
                new SelectListItem { Text = "Uttarakhand", Value = "Uttarakhand" },
                new SelectListItem { Text = "West Bengal", Value = "West Bengal" }
            },
                        new { @class = "form-control select2", onchange = "APortalCustomers._APortalCustomers.LoadCities(this.value,'cityDropdown');", required = "required" })
            @Html.ValidationMessageFor(m => m.State, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>City *</label>
            @Html.DropDownListFor(
            m => m.City,
            new List<SelectListItem>(),
            "-- Select City --",
            new { @class = "form-control select2", id = "cityDropdown" })
            @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger", required = "required" })
        </div>
        <div class="form-group">
            <label>Pin Code *</label>
            @Html.TextBoxFor(m => m.ZipCode, new { @placeholder = "Enter pin code", required = "required",@class="txtspace txtnumeric",MaxLength="6" })
            @Html.ValidationMessageFor(m => m.ZipCode, "", new { @class = "text-danger" })
        </div>
        
        <div class="form-group">
            <label>Reference Code *</label>
            @Html.TextBoxFor(m => m.ReferenceCode, new { @placeholder = "Enter reference code", required = "required", @class = "txtspace", @maxlength = "500" })
            @Html.ValidationMessageFor(m => m.ReferenceCode, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="action-buttons">
        @if (Model.Id == 0)
        {
            <button class="btn btn-danger" id="ClearPage" type="button"
                    onclick="APortalModule._APortalMaster.FormDataClear(APortalCustomers._APortalCustomers);">
                <i class="fa-solid fa-refresh"></i>
            </button>
        }
        else
        {
            <button class="btn btn-danger" id="resetPage" type="button"
                    onclick="APortalModule._APortalMaster.FormDataReset('tblCustomersList','@Model.Id');">
                <i class="fa-solid fa-refresh"></i>
            </button>
        }
        <button class="btn btn-success" id="saveCustomer" type="submit"
                onclick="APortalCustomers._APortalCustomers.SubmitFormData(event, $('#nav_customer_form'));">
            <i class="fa-solid fa-floppy-disk"></i>
        </button>
    </div>
</form>
