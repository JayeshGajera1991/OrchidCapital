@model IEnumerable<OrchidCapital.Models.ImageConfigModel>
@{
    if (Model.Count() == 0)
    {
        <tr data-total-records="0" id="0">
            <td colspan="8" style="text-align: center;">Image configurations aren’t set up yet. Please add them to continue.
            </td>
        </tr>
    }
    else
    {
        foreach (ImageConfigModel item in Model)
        {
            <tr data-total-records="@item.TotalRecords" id="@item.Id">
                <td>@item.Headline</td>
                <td>@item.Role</td>
                <td>@item.Type</td>
                <td>@item.Description</td>
                <td><img src="/ImageUploads/@item.ImagePath" alt="Image" style="max-width: 60px; max-height: 60px;" /></td>
                <td>
                    <span class="status-dot @(item.IsActive ? "active-dot" : "inactive-dot")"></span>
                    @(item.IsActive ? "Active" : "Inactive")
                </td>
                <td>@item.CreatedOn</td>
                <td class="text-center">
                    <div class="action-wrapper">
                        <button class="action-btn" data-id="@item.Id"
                                onclick="APortalImageConfiguration._APortalImageConfiguration.toggleMenu(this)">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <div class="action-menu">
                            <div id="edit-@item.Id" onclick="APortalImageConfiguration._APortalImageConfiguration.Edit('@item.Id')">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </div>

                            <div  id="status-@item.Id"
                                onclick="APortalImageConfiguration._APortalImageConfiguration.Status('@item.Id', '@item.IsActive')">
                                <i class="fa-solid fa-toggle-on"></i>
                                @(item.IsActive ? "Inactive" : "Active")
                            </div>
                            
                            @if (item.IsActive == false)
                            {
                                <div id="remove-@item.Id" onclick="APortalImageConfiguration._APortalImageConfiguration.Delete('@item.Id')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    }
}