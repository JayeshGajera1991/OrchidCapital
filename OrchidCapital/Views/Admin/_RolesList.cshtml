@model IEnumerable<OrchidCapital.Models.RoleModel>
@{
    if (Model.Count() == 0)
    {
        <tr data-total-records="0" id="0">
            <td colspan="4" style="text-align: center;">Roles aren’t set up yet. Please add them to continue.</td>
        </tr>
    }
    else
    {
        foreach (RoleModel item in Model)
        {
            <tr data-total-records="@item.TotalRecords" id="@item.Id">
                 <td>@item.Id</td>
                <td>@item.Role</td>
                <td>
                    <span class="status-dot @(item.IsActive ? "active-dot" : "inactive-dot")"></span>
                    @(item.IsActive ? "Active" : "Inactive")
                </td>
                <td>@item.CreatedOn</td>
                <td>@item.CreatedBy</td>
                <td class="text-center">
                    <div class="action-wrapper">
                        <button class="action-btn" data-id="@item.Id" onclick="APortalRoles._APortalRoles.toggleMenu(this)">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <div class="action-menu">
                            <div id="edit-@item.Id" onclick="APortalRoles._APortalRoles.Edit('@item.Id')">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </div>

                            <div onclick="APortalRoles._APortalRoles.Status('@item.Id', '@item.IsActive')">
                                <i class="fa-solid fa-toggle-on"></i>
                                @(item.IsActive ? "Inactive" : "Active")
                            </div>

                            @if (item.IsActive == false)
                            {
                                <div onclick="APortalRoles._APortalRoles.Delete('@item.Id')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    }
}