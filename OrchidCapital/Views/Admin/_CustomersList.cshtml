@model IEnumerable<OrchidCapital.Models.GetUserDetailsModel>
@{
    if (Model.Count() == 0)
    {
        <tr data-total-records="0" id="0">
            <td colspan="4" style="text-align: center;">Customers aren’t set up yet. Please add them to continue.</td>
        </tr>
    }
    else
    {
        foreach (GetUserDetailsModel item in Model)
        {
            <tr data-total-records="@item.TotalRecords" id="@item.Id">
                <td>@item.UserName</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.MobileNo</td>
                <td>@item.EmailId</td>
                <td>@item.RoleName</td>
                <td>
                    <span class="status-dot @(item.IsActive ? "active-dot" : "inactive-dot")"></span>
                    @(item.IsActive ? "Active" : "Inactive")
                </td>
                <td>@item.CreatedOn</td>
                <td>@item.CreatedBy</td>
                <td class="text-center">
                    <div class="action-wrapper">
                        <button class="action-btn" data-id="@item.Id" onclick="APortalCustomers._APortalCustomers.toggleMenu(this)">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <div class="action-menu">
                            <div id="edit-@item.Id" onclick="APortalCustomers._APortalCustomers.Edit('@item.Id')">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </div>

                            <div id="status-@item.Id" onclick="APortalCustomers._APortalCustomers.Status('@item.Id', '@item.IsActive')">
                                <i class="fa-solid fa-toggle-on"></i>
                                @(item.IsActive ? "Inactive" : "Active")
                            </div>

                            @if (item.IsWCSend == false)
                            {
                                <div id="wc-@item.Id" onclick="APortalCustomers._APortalCustomers.SendWelcomeEmailUser('@item.UserName')">
                                    <i class="fa-solid fa-envelope"></i> Send Welcome Email
                                </div>
                            }

                            @if (item.IsLocked == true)
                            {
                                <div id="lock-@item.Id" onclick="APortalCustomers._APortalCustomers.UnlockUser('@item.UserName')">
                                    <i class="fa-solid fa-lock-open"></i> Unlock
                                </div>
                            }

                            <div id="reset-@item.Id" onclick="APortalCustomers._APortalCustomers.ResetPasswordUser('@item.UserName')">
                                <i class="fa-solid fa-user-lock"></i> Reset Password
                            </div>

                            @if (item.IsTwoFactor == true)
                            {
                                <div id="twofactor-@item.Id"
                                     onclick="APortalCustomers._APortalCustomers.ResetTwoFactorAuthenticationUser('@item.UserName')">
                                    <i class="fa-solid fa-rotate-right"></i> Reset Two Factor Authentication
                                </div>
                            }

                            @if (item.IsActive == false)
                            {
                                <div id="remove-@item.Id" onclick="APortalCustomers._APortalCustomers.DeleteUser('@item.UserName')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    }
}