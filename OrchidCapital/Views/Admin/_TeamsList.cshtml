@model IEnumerable<OrchidCapital.Models.TeamModel>
@{
    if (Model.Count() == 0)
    {
        <tr data-total-records="0" id="0">
            <td colspan="9" style="text-align: center;">Teams aren’t set up yet. Please add them to continue.</td>
        </tr>
    }
    else
    {
        foreach (TeamModel item in Model)
        {
            <tr data-total-records="@item.TotalRecords" id="@item.Id">
                <td>@item.FullName</td>
                <td>@item.Role</td>
                <td>@item.Qualification</td>
                <td>@item.Headline</td>
                <td>@item.Description1</td>
                <td>@item.Description2</td>
                <td>
                    <span class="status-dot @(item.IsActive ? "active-dot" : "inactive-dot")"></span>
                    @(item.IsActive ? "Active" : "Inactive")
                </td>
                <td>@item.CreatedOn</td>
                <td class="text-center">
                    <div class="action-wrapper">
                        <button class="action-btn" data-id="@item.Id" onclick="APortalTeams._APortalTeams.toggleMenu(this)">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <div class="action-menu">
                            <div id="edit-@item.Id" onclick="APortalTeams._APortalTeams.Edit('@item.Id')">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </div>

                            <div id="status-@item.Id" onclick="APortalTeams._APortalTeams.Status('@item.Id', '@item.IsActive')">
                                <i class="fa-solid fa-toggle-on"></i>
                                @(item.IsActive ? "Inactive" : "Active")
                            </div>

                            @if(item.IsActive == false)
                            {
                                <div id="remove-@item.Id" onclick="APortalTeams._APortalTeams.Delete('@item.Id')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    }
}